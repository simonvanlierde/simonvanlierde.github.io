  repository = {https://github.com/simonvanlierde/ramascene-explorer},
  url = {https://github.com/simonvanlierde/ramascene-explorer},
  license = {MIT},
  abstract = {RaMa-Scene Explorer traces the supply chains behind consumption using EXIOBASE v3.3.sm data for 2011. It maps where greenhouse-gas emissions, employment and metal-ore extraction occur across 49 countries and regions, grouped into 15 industry sections. Readers can trace a footprint, inspect its flows and compare 155 published scenarios. Custom scenarios compute on the reader's device, in WebAssembly, or through an optional RaMa-Scene job API. The model changes monetary final demand or inputs per unit of output, with prices and other coefficients fixed. The results describe the 2011 economy, not forecasts. Methods, assumptions, provenance and numerical checks accompany the results. The code is MIT-licensed; derived EXIOBASE data is shared under CC BY 4.0.},
  keywords = {input-output analysis, EXIOBASE, consumption-based accounting, embodied emissions, scenario analysis, data visualization},
}
