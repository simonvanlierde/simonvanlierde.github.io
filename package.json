{
  "name": "simonvanlierde-site",
  "type": "module",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "description": "Personal website for Simon van Lierde, research software engineer and PhD candidate at CML, Leiden University.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "prepare": "lefthook install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro check",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "gen:og": "node scripts/gen-og.mjs",
    "gen:card": "node scripts/social-card/card.mjs",
    "fetch:stats": "node scripts/fetch-stats.mjs",
    "fetch:evidence": "node scripts/fetch-evidence.mjs",
    "fetch:cards": "node scripts/fetch-cards.mjs",
    "fetch:codemeta": "node scripts/fetch-codemeta.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/preact": "^6.0.5",
    "astro": "^7.3.3",
    "preact": "^10.29.8",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "lefthook": "^2.1.14",
    "sharp": "^0.35.4"
  }
}
