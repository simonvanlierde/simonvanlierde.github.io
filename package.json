{
  "name": "simonvanlierde-site",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "description": "Personal website for Simon van Lierde, PhD researcher at CML, Leiden University.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "lefthook install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "astro check",
    "test": "node --test",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "gen:og": "node scripts/gen-og.mjs",
    "fetch:stats": "node scripts/fetch-stats.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^6.0.5",
    "astro": "^7.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "lefthook": "^2.1.12",
    "sharp": "^0.35.4"
  }
}
