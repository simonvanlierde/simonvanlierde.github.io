---
// Header strip shared by the sheets: wordmark, sheet links, theme toggle.
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Current sheet, for aria-current. Omit on other pages (the 404). */
  current?: "index" | "cv" | "archive" | "notes";
}

const { current } = Astro.props;
---

<nav class="sheet-nav" aria-label="Primary">
  <div class="container sheet-nav__inner">
    {/* On the index, the monogram scrolls back up instead of reloading the page. */}
    {
      current === "index" ? (
        <a class="sheet-nav__mark" href="#top" aria-label="SVL, back to top">SVL</a>
      ) : (
        <a class="sheet-nav__mark" href="/" aria-label="SVL, home">SVL</a>
      )
    }
    {/* Narrow screens letter the name only; "Sheet 1: Index" stays the accessible name. One inner span,
        because each flex item of the link would add a space to its name. */}
    <div class="sheet-nav__actions">
      <a class="sheet-nav__link" href="/" aria-current={current === "index" ? "page" : undefined}>
        <span><span class="sheet-nav__number">Sheet 1: </span>Index</span>
      </a>
      <a class="sheet-nav__link" href="/cv/" aria-current={current === "cv" ? "page" : undefined}>
        <span><span class="sheet-nav__number">Sheet 2: </span>CV</span>
      </a>
      <a class="sheet-nav__link" href="/archive/" aria-current={current === "archive" ? "page" : undefined}>
        <span><span class="sheet-nav__number">Sheet 3: </span>Archive</span>
      </a>
      <a class="sheet-nav__link" href="/notes/" aria-current={current === "notes" ? "page" : undefined}>
        <span><span class="sheet-nav__number">Sheet 4: </span>Notes</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
</nav>
