---
import { projectMetadata } from "../data/projectSchema.ts";

interface Props {
  repo: string;
}
const metadata = projectMetadata(Astro.props.repo);
const name = Astro.props.repo.split("/").at(-1);
// The label is the URL's last non-empty path segment: "MIT" from spdx.org/licenses/MIT.html.
const licenses = (metadata?.license ? [metadata.license].flat() : []).map((href) => ({
  href,
  label:
    new URL(href).pathname
      .split("/")
      .filter(Boolean)
      .at(-1)
      ?.replace(/\.html$/, "") ?? href,
}));
---
{metadata && <p class="project-metadata draft">
  {metadata.version && <span>v{metadata.version}</span>}
  {metadata.doi && <a href={metadata.doi} aria-label={`DOI for ${name}`}>DOI</a>}
  {licenses.map(({ href, label }) => <a href={href} aria-label={`${label} licence for ${name}`}>{label}</a>)}
</p>}
