---
// The sheet's figure: ReLab, the lab's own platform, drawn taken apart, the
// way the lab takes products apart. Six parts on a dash-dot axis, capture end
// at the top, foundation at the bottom, in flat front elevation. Each part
// carries a balloon keyed to the left register, and each part is a link to
// the real thing: the plugin repo, the live app, the docs, the source. On
// load the parts settle apart from the assembled stack (reduced motion: the
// drawing starts exploded).
const repo = "https://github.com/CMLPlatform/relab";
const parts = [
  {
    id: "rig",
    name: "Camera rig",
    href: "https://github.com/CMLPlatform/relab-rpi-cam-plugin",
    to: "RPi camera plugin on GitHub",
  },
  { id: "app", name: "Capture app", href: repo, to: "ReLab source on GitHub" },
  { id: "web", name: "Web app", href: "https://app.cml-relab.org", to: "the live platform" },
  { id: "api", name: "API", href: repo, to: "ReLab source on GitHub" },
  { id: "db", name: "Database", href: repo, to: "ReLab source on GitHub" },
  { id: "docs", name: "Docs", href: "https://docs.cml-relab.org", to: "ReLab documentation" },
];
const link = (id: string) => parts.find((p) => p.id === id) ?? parts[0];
---

<figure class="exploded" aria-labelledby="exploded-caption" aria-describedby="exploded-instruction">
  <p class="exploded__instruction" id="exploded-instruction">Open any numbered part.</p>
  <svg
    class="exploded__svg exploded__svg--desktop"
    viewBox="0 0 340 640"
    role="group"
    aria-label="Exploded view of ReLab; each part links to its source, app, or docs"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {/* centreline: the dash-dot axis every assembly is drawn on */}
    <line class="axis" x1="220" y1="8" x2="220" y2="478" stroke-dasharray="14 5 2 5"></line>

    {/* ============ PARTS (top to bottom along the axis) ============ */}
    {/* 1 Camera rig: the Raspberry Pi board with its camera module */}
    <a href={link("rig").href} aria-label={`${link("rig").name}: ${link("rig").to}`}>
      <g class="part part--rig">
        <rect x="170" y="16" width="100" height="56"></rect>
        <g class="fine">
          <circle cx="177" cy="23" r="2.5"></circle>
          <circle cx="263" cy="23" r="2.5"></circle>
          <circle cx="177" cy="65" r="2.5"></circle>
          <circle cx="263" cy="65" r="2.5"></circle>
          <line x1="186" y1="20" x2="254" y2="20"></line>
          <line x1="186" y1="24" x2="254" y2="24"></line>
        </g>
        <rect x="202" y="26" width="36" height="36"></rect>
        <circle cx="220" cy="44" r="10"></circle>
        <circle class="fine" cx="220" cy="44" r="4"></circle>
        <g class="balloon-mark">
          <line class="leader" x1="270" y1="44" x2="304" y2="44"></line>
          <circle cx="314" cy="44" r="9.5"></circle>
          <text class="fig-num" x="314" y="47.5" text-anchor="middle">1</text>
        </g>
      </g>
      <g class="label label--rig">
          <text class="fig-label" x="12" y="48">CAMERA RIG</text>
          <path class="ext" d="M133 47 140 40 M135.5 40 H140 V44.5"></path>
      </g>
    </a>

    {/* 2 Capture app: the phone, viewfinder open */}
    <a href={link("app").href} aria-label={`${link("app").name}: ${link("app").to}`}>
      <g class="part part--app">
        <rect x="186" y="90" width="68" height="96"></rect>
        <g class="fine">
          <rect x="192" y="100" width="56" height="76"></rect>
          <line x1="210" y1="96" x2="230" y2="96"></line>
          <line x1="210" y1="180" x2="230" y2="180"></line>
        </g>
        <g class="fine">
          <polyline points="200,118 200,110 208,110"></polyline>
          <polyline points="232,110 240,110 240,118"></polyline>
          <polyline points="200,158 200,166 208,166"></polyline>
          <polyline points="232,166 240,166 240,158"></polyline>
        </g>
        <circle cx="220" cy="138" r="7"></circle>
        <g class="balloon-mark">
          <line class="leader" x1="254" y1="138" x2="304" y2="138"></line>
          <circle cx="314" cy="138" r="9.5"></circle>
          <text class="fig-num" x="314" y="141.5" text-anchor="middle">2</text>
        </g>
      </g>
      <g class="label label--app">
          <text class="fig-label" x="12" y="142">CAPTURE APP</text>
          <path class="ext" d="M133 141 140 134 M135.5 134 H140 V138.5"></path>
      </g>
    </a>

    {/* 3 Web app: a browser window over a table */}
    <a href={link("web").href} aria-label={`${link("web").name}: ${link("web").to}`}>
      <g class="part part--web">
        <rect x="150" y="204" width="140" height="72"></rect>
        <g class="fine">
          <line x1="150" y1="218" x2="290" y2="218"></line>
          <circle cx="160" cy="211" r="2.5"></circle>
          <circle cx="169" cy="211" r="2.5"></circle>
          <circle cx="178" cy="211" r="2.5"></circle>
          <line x1="160" y1="232" x2="280" y2="232"></line>
          <line x1="160" y1="244" x2="280" y2="244"></line>
          <line x1="160" y1="256" x2="280" y2="256"></line>
          <line x1="160" y1="268" x2="280" y2="268"></line>
          <line x1="196" y1="226" x2="196" y2="272"></line>
        </g>
        <g class="balloon-mark">
          <line class="leader" x1="290" y1="240" x2="304" y2="240"></line>
          <circle cx="314" cy="240" r="9.5"></circle>
          <text class="fig-num" x="314" y="243.5" text-anchor="middle">3</text>
        </g>
      </g>
      <g class="label label--web">
          <text class="fig-label" x="12" y="244">WEB APP</text>
          <path class="ext" d="M133 243 140 236 M135.5 236 H140 V240.5"></path>
      </g>
    </a>

    {/* 4 API: one rack unit */}
    <a href={link("api").href} aria-label={`${link("api").name}: ${link("api").to}`}>
      <g class="part part--api">
        <rect x="160" y="294" width="120" height="36"></rect>
        <g class="fine">
          <rect x="170" y="306" width="12" height="12"></rect>
          <rect x="188" y="306" width="12" height="12"></rect>
          <rect x="206" y="306" width="12" height="12"></rect>
          <line x1="236" y1="312" x2="256" y2="312"></line>
        </g>
        <circle cx="268" cy="312" r="3"></circle>
        <g class="balloon-mark">
          <line class="leader" x1="280" y1="312" x2="304" y2="312"></line>
          <circle cx="314" cy="312" r="9.5"></circle>
          <text class="fig-num" x="314" y="315.5" text-anchor="middle">4</text>
        </g>
      </g>
      <g class="label label--api">
          <text class="fig-label" x="12" y="316">API</text>
          <path class="ext" d="M133 315 140 308 M135.5 308 H140 V312.5"></path>
      </g>
    </a>

    {/* 5 Database: the cylinder */}
    <a href={link("db").href} aria-label={`${link("db").name}: ${link("db").to}`}>
      <g class="part part--db">
        <ellipse cx="220" cy="358" rx="42" ry="10"></ellipse>
        <line x1="178" y1="358" x2="178" y2="394"></line>
        <line x1="262" y1="358" x2="262" y2="394"></line>
        <path d="M178 394 A42 10 0 0 0 262 394"></path>
        <g class="fine">
          <path d="M178 370 A42 10 0 0 0 262 370"></path>
          <path d="M178 382 A42 10 0 0 0 262 382"></path>
        </g>
        <g class="balloon-mark">
          <line class="leader" x1="262" y1="376" x2="304" y2="376"></line>
          <circle cx="314" cy="376" r="9.5"></circle>
