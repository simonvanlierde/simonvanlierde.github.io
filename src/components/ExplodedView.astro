---
// The sheet's figure: RELab, the lab's own platform, drawn taken apart, the
// way the lab takes products apart. Six parts on a dash-dot axis, capture
// end at the top, foundation at the bottom, all in flat front elevation:
// camera rig, capture app, web app, API, database, docs. Each part carries a
// balloon; the left register keys the balloons to part names, so the figure
// has the drawing half of the balloon convention. Every part is something
// the CV export and the RELab row already state; nothing here is invented,
// and the RELab counts live in the hero's general notes, not on the parts.
// On load the parts settle apart from the assembled stack (reduced motion:
// the drawing is simply exploded).

// Part names, top to bottom along the axis: the accessible reading of the
// figure. The SVG register below mirrors this list.
const parts = ["Camera rig", "Capture app", "Web app", "API", "Database", "Docs"];
---

<figure class="exploded" aria-labelledby="exploded-caption">
  <svg
    class="exploded__svg"
    viewBox="0 0 340 640"
    aria-hidden="true"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {/* centreline: the dash-dot axis every assembly is drawn on */}
    <line class="axis" x1="220" y1="10" x2="220" y2="632" stroke-dasharray="14 5 2 5"></line>

    {/* ============ PARTS (top to bottom along the axis) ============ */}
    {/* 1 Camera rig: the Raspberry Pi board with its camera module */}
    <g class="part part--rig">
      <rect x="170" y="40" width="100" height="64"></rect>
      <g class="fine">
        <circle cx="177" cy="47" r="2.5"></circle>
        <circle cx="263" cy="47" r="2.5"></circle>
        <circle cx="177" cy="97" r="2.5"></circle>
        <circle cx="263" cy="97" r="2.5"></circle>
        <line x1="186" y1="44" x2="254" y2="44"></line>
        <line x1="186" y1="48" x2="254" y2="48"></line>
      </g>
      <rect x="202" y="56" width="36" height="36"></rect>
      <circle cx="220" cy="74" r="10"></circle>
      <circle class="fine" cx="220" cy="74" r="4"></circle>
      <g class="balloon-mark">
        <line class="leader" x1="270" y1="72" x2="304" y2="72"></line>
        <circle cx="314" cy="72" r="9.5"></circle>
        <text class="fig-num" x="314" y="75.5" text-anchor="middle">1</text>
      </g>
    </g>

    {/* 2 Capture app: the phone, viewfinder open */}
    <g class="part part--app">
      <rect x="186" y="140" width="68" height="124"></rect>
      <g class="fine">
        <rect x="192" y="152" width="56" height="100"></rect>
        <line x1="210" y1="146" x2="230" y2="146"></line>
        <line x1="210" y1="258" x2="230" y2="258"></line>
      </g>
      <g class="fine">
        <polyline points="200,170 200,162 208,162"></polyline>
        <polyline points="232,162 240,162 240,170"></polyline>
        <polyline points="200,234 200,242 208,242"></polyline>
        <polyline points="232,242 240,242 240,234"></polyline>
      </g>
      <circle cx="220" cy="202" r="7"></circle>
      <g class="balloon-mark">
        <line class="leader" x1="254" y1="202" x2="304" y2="202"></line>
        <circle cx="314" cy="202" r="9.5"></circle>
        <text class="fig-num" x="314" y="205.5" text-anchor="middle">2</text>
      </g>
    </g>

    {/* 3 Web app: a browser window over a table */}
    <g class="part part--web">
      <rect x="150" y="290" width="140" height="92"></rect>
      <g class="fine">
        <line x1="150" y1="306" x2="290" y2="306"></line>
        <circle cx="160" cy="298" r="2.5"></circle>
        <circle cx="169" cy="298" r="2.5"></circle>
        <circle cx="178" cy="298" r="2.5"></circle>
        <line x1="160" y1="322" x2="280" y2="322"></line>
        <line x1="160" y1="338" x2="280" y2="338"></line>
        <line x1="160" y1="354" x2="280" y2="354"></line>
        <line x1="160" y1="370" x2="280" y2="370"></line>
        <line x1="196" y1="314" x2="196" y2="374"></line>
      </g>
      <g class="balloon-mark">
        <line class="leader" x1="290" y1="336" x2="304" y2="336"></line>
        <circle cx="314" cy="336" r="9.5"></circle>
        <text class="fig-num" x="314" y="339.5" text-anchor="middle">3</text>
      </g>
    </g>

    {/* 4 API: one rack unit */}
    <g class="part part--api">
      <rect x="160" y="412" width="120" height="36"></rect>
      <g class="fine">
        <rect x="170" y="424" width="12" height="12"></rect>
        <rect x="188" y="424" width="12" height="12"></rect>
        <rect x="206" y="424" width="12" height="12"></rect>
        <line x1="236" y1="430" x2="256" y2="430"></line>
      </g>
      <circle cx="268" cy="430" r="3"></circle>
      <g class="balloon-mark">
        <line class="leader" x1="280" y1="430" x2="304" y2="430"></line>
        <circle cx="314" cy="430" r="9.5"></circle>
        <text class="fig-num" x="314" y="433.5" text-anchor="middle">4</text>
      </g>
    </g>

    {/* 5 Database: the cylinder */}
    <g class="part part--db">
      <ellipse cx="220" cy="486" rx="42" ry="10"></ellipse>
      <line x1="178" y1="486" x2="178" y2="540"></line>
      <line x1="262" y1="486" x2="262" y2="540"></line>
      <path d="M178 540 A42 10 0 0 0 262 540"></path>
      <g class="fine">
        <path d="M178 504 A42 10 0 0 0 262 504"></path>
        <path d="M178 522 A42 10 0 0 0 262 522"></path>
      </g>
      <g class="balloon-mark">
        <line class="leader" x1="262" y1="513" x2="304" y2="513"></line>
        <circle cx="314" cy="513" r="9.5"></circle>
        <text class="fig-num" x="314" y="516.5" text-anchor="middle">5</text>
      </g>
    </g>

    {/* 6 Docs: a bound sheet */}
    <g class="part part--docs">
      <rect x="180" y="578" width="80" height="56"></rect>
      <g class="fine">
        <line x1="192" y1="578" x2="192" y2="634"></line>
        <circle cx="186" cy="590" r="1.8"></circle>
        <circle cx="186" cy="606" r="1.8"></circle>
        <circle cx="186" cy="622" r="1.8"></circle>
        <line x1="202" y1="592" x2="250" y2="592"></line>
        <line x1="202" y1="604" x2="250" y2="604"></line>
        <line x1="202" y1="616" x2="236" y2="616"></line>
      </g>
      <g class="balloon-mark">
        <line class="leader" x1="260" y1="606" x2="304" y2="606"></line>
        <circle cx="314" cy="606" r="9.5"></circle>
        <text class="fig-num" x="314" y="609.5" text-anchor="middle">6</text>
      </g>
    </g>

    {/* ============ REGISTER (left): the balloons keyed to part names ============ */}
    <g class="labels">
      <g class="label label--rig">
        <text class="fig-num" x="12" y="76">1</text>
        <text class="fig-label" x="30" y="76">CAMERA RIG</text>
      </g>
      <g class="label label--app">
        <text class="fig-num" x="12" y="206">2</text>
        <text class="fig-label" x="30" y="206">CAPTURE APP</text>
      </g>
      <g class="label label--web">
        <text class="fig-num" x="12" y="340">3</text>
        <text class="fig-label" x="30" y="340">WEB APP</text>
      </g>
      <g class="label label--api">
        <text class="fig-num" x="12" y="434">4</text>
        <text class="fig-label" x="30" y="434">API</text>
      </g>
      <g class="label label--db">
        <text class="fig-num" x="12" y="517">5</text>
        <text class="fig-label" x="30" y="517">DATABASE</text>
      </g>
      <g class="label label--docs">
        <text class="fig-num" x="12" y="610">6</text>
        <text class="fig-label" x="30" y="610">DOCS</text>
      </g>
    </g>
  </svg>

  <figcaption id="exploded-caption">
    Fig. 1: RELab, the disassembly-data platform I build at CML and one of the
    projects listed below, drawn exploded. Schematic.
    <span class="visually-hidden">Parts, top to bottom: {parts.join(", ")}.</span>
  </figcaption>
</figure>

<script is:inline>
  // Assembled -> exploded on first view. Inline, right after the figure, so
  // the class is on before the drawing's first paint (a deferred module could
  // land after it and pop the parts together); removed a frame later, so
  // the transition runs from the assembled position. No JS, or reduced
  // motion: the static exploded view.
  {
    const fig = document.querySelector(".exploded");
    if (fig && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      fig.classList.add("is-assembled");
      requestAnimationFrame(() => {
        requestAnimationFrame(() => fig.classList.remove("is-assembled"));
      });
    }
  }
</script>

<style>
  /* Plate size: the notes carry the proof, the drawing shows the method. */
  .exploded__svg {
    width: 100%;
    height: auto;
    max-width: 20rem;
  }

  /* Linework. A transparent (not none) fill makes the whole part a pointer
     target, so hovering inside a part lights it, not only its stroke. */
  .part {
    fill: transparent;
    stroke: var(--text);
    stroke-width: 1.7;
    transition:
      translate var(--dur-explode) var(--ease-out),
      stroke var(--dur-fast) ease;
  }

  .fine,
  .part .fine {
    stroke: var(--text-muted);
    stroke-width: 1;
  }

  .axis,
  .leader {
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  /* The balloon: a drawing's item mark, keyed to the register. Its stroke
     stays the strong rule; only the numeral answers hover. */
  .balloon-mark circle {
    stroke: var(--border-strong);
    stroke-width: 1.5;
    fill: var(--bg);
  }

  .balloon-mark text {
    fill: var(--text);
  }

  /* Lettering. Sizes are svg units; the drawing caps at 20rem, where one
     unit is 0.94px, so 13 units letters at just over 12px. */
  text {
    stroke: none;
    fill: var(--text-muted);
    font-family: var(--font-draft);
    transition: fill var(--dur-fast) ease;
  }

  .fig-label {
    font-size: 13px;
    letter-spacing: 0.12em;
  }

  .fig-num {
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
    fill: var(--text);
  }

  /* The assembled position: the stack closes onto the API, capture end
     coming down, foundation coming up. Balloons and register labels travel
     with their parts, so the settle reads as one drawing. */
  .label {
    transition: translate var(--dur-explode) var(--ease-out);
  }
  .is-assembled .part--rig,
  .is-assembled .label--rig {
    translate: 0 92px;
  }
  .is-assembled .part--app,
  .is-assembled .label--app {
    translate: 0 56px;
  }
  .is-assembled .part--web,
  .is-assembled .label--web {
    translate: 0 30px;
  }
  .is-assembled .part--db,
  .is-assembled .label--db {
    translate: 0 -28px;
  }
  .is-assembled .part--docs,
  .is-assembled .label--docs {
    translate: 0 -56px;
  }

  /* Hovering a part name lights its part, and hovering a part lights its
     name: the two registers answer each other. Progressive: browsers
     without :has() keep the one-way part hover. */
  .part:hover,
  .exploded:has(.label--rig:hover) .part--rig,
  .exploded:has(.label--app:hover) .part--app,
  .exploded:has(.label--web:hover) .part--web,
  .exploded:has(.label--api:hover) .part--api,
  .exploded:has(.label--db:hover) .part--db,
  .exploded:has(.label--docs:hover) .part--docs {
    stroke: var(--accent);
  }

  .label:hover text,
  .exploded:has(.part--rig:hover) .label--rig text,
  .exploded:has(.part--app:hover) .label--app text,
  .exploded:has(.part--web:hover) .label--web text,
  .exploded:has(.part--api:hover) .label--api text,
  .exploded:has(.part--db:hover) .label--db text,
  .exploded:has(.part--docs:hover) .label--docs text {
    fill: var(--accent);
  }

  /* Reduced motion drops the settle; the 150ms ink change on hover is
     feedback, not movement, and stays. */
  @media (prefers-reduced-motion: reduce) {
    .part {
      transition: stroke var(--dur-fast) ease;
    }

    .label {
      transition: none;
    }
  }

  figcaption {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: var(--measure);
  }
</style>
