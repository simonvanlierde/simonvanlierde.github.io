---
// The sheet's figure: an exploded view of a desk fan (the same object as the
// cv-ie-taxonomy demo), drawn as ink linework on a dash-dot axis with part
// names in a left register. The drawing carries only what a drawing carries:
// parts, names, one real dimension. The RELab counts live in the hero's
// general-notes block, not on the parts. On load the parts settle apart from
// the assembled stack (reduced motion: the drawing is simply exploded).

// Part names, top to bottom along the axis: the accessible reading of the
// figure. The SVG labels below mirror this list.
const parts = ["Front grille", "Blades, 3", "Rear grille", "Motor", "Neck", "Base"];
---

<figure class="exploded" aria-labelledby="exploded-caption">
  <svg
    class="exploded__svg"
    viewBox="0 0 340 640"
    aria-hidden="true"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {/* centreline: the dash-dot axis every assembly is drawn on */}
    <line class="axis" x1="220" y1="10" x2="220" y2="632" stroke-dasharray="14 5 2 5"></line>

    {/* ============ PARTS (top to bottom along the axis) ============ */}
    <g class="part part--front-grille">
      <circle cx="220" cy="92" r="72"></circle>
      <circle class="fine" cx="220" cy="92" r="50"></circle>
      <circle class="fine" cx="220" cy="92" r="27"></circle>
      <circle cx="220" cy="92" r="9"></circle>
      <g class="fine">
        <line x1="220" y1="20" x2="220" y2="83"></line>
        <line x1="220" y1="101" x2="220" y2="164"></line>
        <line x1="148" y1="92" x2="211" y2="92"></line>
        <line x1="229" y1="92" x2="292" y2="92"></line>
        <line x1="169.1" y1="41.1" x2="213.6" y2="85.6"></line>
        <line x1="226.4" y1="98.4" x2="270.9" y2="142.9"></line>
        <line x1="270.9" y1="41.1" x2="226.4" y2="85.6"></line>
        <line x1="213.6" y1="98.4" x2="169.1" y2="142.9"></line>
        <line x1="184" y1="29.6" x2="215.5" y2="84.2"></line>
        <line x1="224.5" y1="99.8" x2="256" y2="154.4"></line>
        <line x1="256" y1="29.6" x2="224.5" y2="84.2"></line>
        <line x1="215.5" y1="99.8" x2="184" y2="154.4"></line>
        <line x1="157.6" y1="56" x2="212.2" y2="87.5"></line>
        <line x1="227.8" y1="96.5" x2="282.4" y2="128"></line>
        <line x1="282.4" y1="56" x2="227.8" y2="87.5"></line>
        <line x1="212.2" y1="96.5" x2="157.6" y2="128"></line>
      </g>
    </g>

    <g class="part part--blades">
      <circle cx="220" cy="240" r="12"></circle>
      <path d="M220 240 C232 233 241 221 244 201 C246 184 236 173 224 179 C213 185 208 208 211 229 Z"></path>
      <path d="M220 240 C213 251 200 258 181 256 C164 254 156 241 165 231 C174 222 197 224 216 232 Z"></path>
      <path d="M220 240 C227 251 240 258 259 256 C276 254 284 241 275 231 C266 222 243 224 224 232 Z"></path>
    </g>

    <g class="part part--rear-grille">
      <circle cx="220" cy="358" r="70"></circle>
      <circle class="fine" cx="220" cy="358" r="40"></circle>
      <circle cx="220" cy="358" r="14"></circle>
      <g class="fine">
        <line x1="220" y1="288" x2="220" y2="344"></line>
        <line x1="220" y1="372" x2="220" y2="428"></line>
        <line x1="150" y1="358" x2="206" y2="358"></line>
        <line x1="234" y1="358" x2="290" y2="358"></line>
        <line x1="170.5" y1="308.5" x2="210.1" y2="348.1"></line>
        <line x1="229.9" y1="367.9" x2="269.5" y2="407.5"></line>
        <line x1="269.5" y1="308.5" x2="229.9" y2="348.1"></line>
        <line x1="210.1" y1="367.9" x2="170.5" y2="407.5"></line>
      </g>
    </g>

    <g class="part part--motor">
      <rect x="180" y="450" width="80" height="50"></rect>
      <line class="fine" x1="192" y1="458" x2="192" y2="492"></line>
      <line class="fine" x1="202" y1="458" x2="202" y2="492"></line>
      <line class="fine" x1="212" y1="458" x2="212" y2="492"></line>
      <line class="fine" x1="228" y1="458" x2="228" y2="492"></line>
      <line class="fine" x1="238" y1="458" x2="238" y2="492"></line>
      <line class="fine" x1="248" y1="458" x2="248" y2="492"></line>
      <circle cx="220" cy="475" r="6"></circle>
    </g>

    <g class="part part--neck">
      <rect x="211" y="522" width="18" height="60"></rect>
      <line class="fine" x1="211" y1="540" x2="229" y2="540"></line>
    </g>

    <g class="part part--base">
      <rect x="150" y="600" width="140" height="22"></rect>
      <line class="fine" x1="160" y1="611" x2="176" y2="611"></line>
      <line class="fine" x1="264" y1="611" x2="280" y2="611"></line>
      <line x1="150" y1="622" x2="140" y2="632"></line>
      <line x1="290" y1="622" x2="300" y2="632"></line>
    </g>

    {/* guard diameter: the one dimension a fan is sold by */}
    <g class="dim">
      <line x1="148" y1="12" x2="292" y2="12"></line>
      <line x1="148" y1="7" x2="148" y2="17"></line>
      <line x1="292" y1="7" x2="292" y2="17"></line>
      <text class="fig-fine" x="220" y="9" text-anchor="middle">Ø 300</text>
    </g>

    {/* ============ PART NAMES (left register) ============ */}
    <g class="labels">
      <g class="label label--front-grille">
        <text class="fig-label" x="12" y="60">FRONT GRILLE</text>
        <line class="leader" x1="112" y1="56" x2="160" y2="52"></line>
      </g>
      <g class="label label--blades">
        <text class="fig-label" x="12" y="216">BLADES, 3</text>
        <line class="leader" x1="88" y1="212" x2="182" y2="232"></line>
      </g>
      <g class="label label--rear-grille">
        <text class="fig-label" x="12" y="330">REAR GRILLE</text>
        <line class="leader" x1="106" y1="326" x2="160" y2="322"></line>
      </g>
      <g class="label label--motor">
        <text class="fig-label" x="12" y="482">MOTOR</text>
        <line class="leader" x1="60" y1="478" x2="180" y2="475"></line>
      </g>
      <g class="label label--neck">
        <text class="fig-label" x="12" y="560">NECK</text>
        <line class="leader" x1="52" y1="556" x2="211" y2="552"></line>
      </g>
      <g class="label label--base">
        <text class="fig-label" x="12" y="618">BASE</text>
        <line class="leader" x1="52" y1="614" x2="150" y2="611"></line>
      </g>
    </g>
  </svg>

  <figcaption id="exploded-caption">
    Fig. 1: Exploded view of a desk fan, illustrative.
    <span class="visually-hidden">Parts, top to bottom: {parts.join(", ")}.</span>
  </figcaption>
</figure>

<script is:inline>
  // Assembled -> exploded on first view. Inline, right after the figure, so
  // the class is on before the drawing's first paint (a deferred module could
  // land after it and pop the parts together); removed a frame later, so
  // the transition runs from the assembled position. No JS, or reduced
  // motion: the static exploded view.
  {
    const fig = document.querySelector(".exploded");
    if (fig && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      fig.classList.add("is-assembled");
      requestAnimationFrame(() => {
        requestAnimationFrame(() => fig.classList.remove("is-assembled"));
      });
    }
  }
</script>

<style>
  .exploded__svg {
    width: 100%;
    height: auto;
    max-width: 24rem;
  }

  /* Linework */
  .part {
    stroke: var(--text);
    stroke-width: 1.7;
    transition:
      translate var(--dur-explode) var(--ease-out),
      stroke var(--dur-fast) ease;
  }

  .fine,
  .part .fine {
    stroke: var(--text-muted);
    stroke-width: 1;
  }

  .axis,
  .leader,
  .dim {
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  /* Lettering. Sizes are svg units; the drawing caps at 24rem, where one
     unit is just over 1px, so nothing renders below its declared size. */
  text {
    stroke: none;
    fill: var(--text-muted);
    font-family: var(--font-draft);
  }

  .fig-label {
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .fig-fine {
    font-size: 10.5px;
    letter-spacing: 0.08em;
  }

  /* The assembled position: the front stack closes onto the rear grille,
     the stand rises to meet the motor. */
  .is-assembled .part--front-grille {
    translate: 0 240px;
  }
  .is-assembled .part--blades {
    translate: 0 118px;
  }
  .is-assembled .part--motor {
    translate: 0 -46px;
  }
  .is-assembled .part--neck {
    translate: 0 -66px;
  }
  .is-assembled .part--base {
    translate: 0 -104px;
  }

  /* Hovering a part name lights its part; the name answers in kind.
     Progressive: browsers without :has() simply keep the static drawing. */
  .exploded:has(.label--front-grille:hover) .part--front-grille,
  .exploded:has(.label--blades:hover) .part--blades,
  .exploded:has(.label--rear-grille:hover) .part--rear-grille,
  .exploded:has(.label--motor:hover) .part--motor,
  .exploded:has(.label--neck:hover) .part--neck,
  .exploded:has(.label--base:hover) .part--base {
    stroke: var(--accent);
  }

  .label:hover text {
    fill: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .part {
      transition: none;
    }
  }

  figcaption {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: var(--measure);
  }
</style>
