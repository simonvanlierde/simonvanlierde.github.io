      </g>
      <g class="label label--db">
          <text class="fig-label" x="12" y="380">DATABASE</text>
          <path class="ext" d="M133 379 140 372 M135.5 372 H140 V376.5"></path>
      </g>
    </a>

    {/* 6 Docs: a bound sheet */}
    <a href={link("docs").href} aria-label={`${link("docs").name}: ${link("docs").to}`}>
      <g class="part part--docs">
        <rect x="180" y="422" width="80" height="48"></rect>
        <g class="fine">
          <line x1="192" y1="422" x2="192" y2="470"></line>
          <circle cx="186" cy="434" r="1.8"></circle>
          <circle cx="186" cy="446" r="1.8"></circle>
          <circle cx="186" cy="458" r="1.8"></circle>
          <line x1="202" y1="436" x2="250" y2="436"></line>
          <line x1="202" y1="446" x2="250" y2="446"></line>
          <line x1="202" y1="456" x2="236" y2="456"></line>
        </g>
        <g class="balloon-mark">
          <line class="leader" x1="260" y1="446" x2="304" y2="446"></line>
          <circle cx="314" cy="446" r="9.5"></circle>
          <text class="fig-num" x="314" y="449.5" text-anchor="middle">6</text>
        </g>
      </g>
      <g class="label label--docs">
          <text class="fig-label" x="12" y="450">DOCS</text>
          <path class="ext" d="M133 449 140 442 M135.5 442 H140 V446.5"></path>
