---
// The sheet's figure: an exploded view of an electric kettle, drawn as ink
// linework, with the four real RELab counts as numbered callout notes. Every
// figure is real and dated; the drawing is authored geometry, not a stock
// illustration. On load the parts settle apart from the assembled position
// (reduced motion: the drawing is simply exploded). Below a 34rem container
// the in-drawing notes hand over to the HTML notes table underneath, so
// no note ever renders below legible size.
//
// Leader mapping is meaningful, not decorative: the whole assembly carries
// the products count, the handle (the human grip) the participants, the
// framed body the images, the heating plate the components.

// Boxed letters, datum-style: circled numerals belong to the bill of
// materials, so the figure's notes take their own notation.
const counts = [
  { ref: "A", label: "Products documented", value: "78", part: "assembly" },
  { ref: "B", label: "Workshop participants", value: "135", part: "handle" },
  { ref: "C", label: "Images captured", value: "3 610", part: "body" },
  { ref: "D", label: "Components catalogued", value: "1 331", part: "plate" },
];
---

<figure class="exploded" aria-labelledby="exploded-caption">
  <svg
    class="exploded__svg"
    viewBox="0 0 460 620"
    aria-hidden="true"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- centreline: the classic dash-dot axis every assembly is drawn on -->
    <line
      class="axis"
      x1="180" y1="14" x2="180" y2="606"
      stroke-dasharray="14 5 2 5"
    ></line>

    <!-- ============ PARTS (top to bottom along the axis) ============ -->
    <g class="part part--lid">
      <circle cx="180" cy="52" r="8"></circle>
      <line x1="180" y1="60" x2="180" y2="68"></line>
      <path d="M120 96 Q180 62 240 96"></path>
      <ellipse cx="180" cy="97" rx="60" ry="9"></ellipse>
    </g>

    <g class="part part--body">
      <ellipse cx="180" cy="168" rx="56" ry="9"></ellipse>
      <path d="M124 168 L114 330"></path>
      <path d="M236 168 L246 330"></path>
      <ellipse cx="180" cy="331" rx="66" ry="10"></ellipse>
      <!-- spout -->
      <path d="M126 178 L96 200 L118 214"></path>
      <!-- handle: the human grip -->
      <path d="M240 186 Q292 200 284 252 Q278 288 244 296"></path>
      <path d="M240 200 Q276 210 270 250 Q266 276 242 282"></path>
      <!-- fill line: a kettle is a measuring vessel too -->
      <line class="fine" x1="130" y1="252" x2="230" y2="252" stroke-dasharray="6 5"></line>
      <text class="fig-fine" x="136" y="246">MAX 1.7 L</text>
    </g>

    <g class="part part--plate">
      <ellipse cx="180" cy="392" rx="54" ry="9"></ellipse>
      <path d="M126 392 L126 404"></path>
      <path d="M234 392 L234 404"></path>
      <ellipse cx="180" cy="404" rx="54" ry="9"></ellipse>
      <circle class="fine" cx="180" cy="394" r="17"></circle>
    </g>

    <g class="part part--base">
      <ellipse cx="180" cy="462" rx="74" ry="11"></ellipse>
      <path d="M106 462 L106 486"></path>
      <path d="M254 462 L254 486"></path>
      <ellipse cx="180" cy="486" rx="74" ry="11"></ellipse>
      <circle cx="180" cy="462" r="6"></circle>
    </g>

    <g class="part part--cord">
      <path d="M116 556 Q146 538 176 556 T236 556"></path>
      <rect x="236" y="548" width="26" height="16"></rect>
      <line x1="262" y1="552" x2="272" y2="552"></line>
      <line x1="262" y1="560" x2="272" y2="560"></line>
    </g>

    <!-- viewfinder corners: the body is the photographed part -->
    <g class="part part--body frame-marks fine">
      <path d="M100 158 L100 146 L112 146"></path>
      <path d="M260 146 L272 146 L272 158"></path>
      <path d="M100 330 L100 342 L112 342"></path>
      <path d="M272 330 L272 342 L260 342"></path>
    </g>

    <!-- ============ PART NAMES (left register) ============ -->
    <g class="labels">
      <text class="fig-label" x="14" y="84">LID</text>
      <line class="fine" x1="52" y1="80" x2="112" y2="88"></line>
      <text class="fig-label" x="14" y="256">BODY</text>
      <line class="fine" x1="60" y1="252" x2="112" y2="252"></line>
      <text class="fig-label" x="14" y="386">HEATING PLATE</text>
      <line class="fine" x1="14" y1="392" x2="120" y2="396"></line>
      <text class="fig-label" x="14" y="452">POWER BASE</text>
      <line class="fine" x1="14" y1="458" x2="100" y2="462"></line>
      <text class="fig-label" x="14" y="586">CORDSET</text>
      <line class="fine" x1="14" y1="578" x2="112" y2="560"></line>
    </g>

    <!-- ============ NUMBERED NOTES (right register) ============ -->
    <g class="callout callout--assembly">
      <line class="leader" x1="246" y1="86" x2="322" y2="64"></line>
      <rect class="datum-mark" x="323" y="49" width="26" height="26"></rect>
      <text class="fig-num" x="336" y="66">A</text>
      <text class="fig-value" x="356" y="58">78</text>
      <text class="fig-label" x="356" y="76">PRODUCTS</text>
    </g>

    <g class="callout callout--handle">
      <line class="leader" x1="288" y1="226" x2="322" y2="202"></line>
      <rect class="datum-mark" x="323" y="187" width="26" height="26"></rect>
      <text class="fig-num" x="336" y="204">B</text>
      <text class="fig-value" x="356" y="196">135</text>
      <text class="fig-label" x="356" y="214">PARTICIPANTS</text>
    </g>

    <g class="callout callout--body">
      <line class="leader" x1="274" y1="316" x2="322" y2="300"></line>
      <rect class="datum-mark" x="323" y="285" width="26" height="26"></rect>
      <text class="fig-num" x="336" y="302">C</text>
      <text class="fig-value" x="356" y="294">3 610</text>
      <text class="fig-label" x="356" y="312">IMAGES</text>
    </g>

    <g class="callout callout--plate">
      <line class="leader" x1="236" y1="400" x2="322" y2="392"></line>
      <rect class="datum-mark" x="323" y="377" width="26" height="26"></rect>
      <text class="fig-num" x="336" y="394">D</text>
      <text class="fig-value" x="356" y="386">1 331</text>
      <text class="fig-label" x="356" y="404">COMPONENTS</text>
    </g>

    <text class="fig-fine" x="446" y="606" text-anchor="end">ALL QUANTITIES AS COUNTED AUG 2026 · CML RELAB</text>
  </svg>

  <!-- The notes, as text: the accessible reading always, the visible one when
       the drawing is too narrow to carry its own lettering. -->
  <figcaption id="exploded-caption">
    <span class="exploded__caption-lead">
      Fig. 1 — Disassembly, an illustrative exploded view. The counts are the
      Reverse Engineering Lab's real running totals, as counted Aug 2026:
    </span>
    <ol class="exploded__notes">
      {
        counts.map((c) => (
          <li>
            <span class="datum" aria-hidden="true">{c.ref}</span>
            <span class="exploded__note-value draft">{c.value}</span>
            <span class="exploded__note-label">{c.label}</span>
          </li>
        ))
      }
    </ol>
  </figcaption>
</figure>

<script>
  // Assembled -> exploded on first view. The class is added before first
  // paint and removed a frame later, so the transition runs from the
  // assembled position. No JS, or reduced motion: the static exploded view.
  const fig = document.querySelector(".exploded");
  if (fig && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    fig.classList.add("is-assembled");
    requestAnimationFrame(() => {
      requestAnimationFrame(() => fig.classList.remove("is-assembled"));
    });
  }
</script>

<style>
  .exploded {
    container: figure / inline-size;
  }

  .exploded__svg {
    width: 100%;
    height: auto;
    max-width: 30rem;
  }

  /* Linework */
  .part {
    stroke: var(--text);
    stroke-width: 1.7;
    transition:
      translate var(--dur-explode) var(--ease-out),
      stroke var(--dur-fast) ease;
  }

  .fine,
  .part .fine {
    stroke: var(--text-muted);
    stroke-width: 1;
  }

  .axis {
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .leader {
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .datum-mark {
    stroke: var(--border-strong);
    stroke-width: 1.5;
    fill: var(--bg);
  }

  .labels line {
    stroke: var(--border);
  }

  /* Lettering. Sizes are svg units; the drawing caps at 30rem, where one
     unit is just over 1px, so nothing renders below its declared size. */
  text {
    stroke: none;
    fill: var(--text-muted);
    font-family: var(--font-draft);
  }

  .fig-label {
    font-size: 12px;
    letter-spacing: 0.12em;
  }

  .fig-value {
    font-size: 25px;
    fill: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .fig-num {
    font-size: 13px;
    fill: var(--text);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .fig-fine {
    font-size: 10.5px;
    letter-spacing: 0.08em;
  }

  /* The assembled position: parts gathered onto the body. */
  .is-assembled .part--lid {
    translate: 0 68px;
  }
  .is-assembled .part--plate {
    translate: 0 -58px;
  }
  .is-assembled .part--base {
    translate: 0 -100px;
  }
  .is-assembled .part--cord {
    translate: 0 -140px;
  }

  /* Hovering a note lights its part; the note text answers in kind.
     Progressive: browsers without :has() simply keep the static drawing. */
  .exploded:has(.callout--assembly:hover) .part,
  .exploded:has(.callout--handle:hover) .part--body,
  .exploded:has(.callout--body:hover) .part--body,
  .exploded:has(.callout--plate:hover) .part--plate {
    stroke: var(--accent);
  }

  .callout:hover text {
    fill: var(--accent);
  }

  .callout:hover .fig-value {
    fill: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .part {
      transition: none;
    }
  }

  /* Caption and notes list */
  figcaption {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .exploded__notes {
    list-style: none;
    margin-top: var(--space-s);
    display: grid;
    gap: var(--space-xs);
  }

  .exploded__notes li {
    display: flex;
    align-items: center;
    gap: var(--space-s);
  }

  .exploded__note-value {
    min-width: 3.4em;
    color: var(--text);
    font-size: var(--step-0);
  }

  /* Wide: the drawing carries its own notes; the list is for readers of the
     text alternative only. Narrow: the drawing's right register is hidden and
     the HTML list becomes the visible notes. */
  @container figure (min-width: 27rem) {
    .exploded__caption-lead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .exploded__notes {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  @container figure (max-width: 26.999rem) {
    .callout,
    .fig-fine,
    .labels {
      display: none;
    }

    /* Without the right-hand note register the kettle would sit in the left
       two-thirds of its box; enlarge and crop so the axis lands centred. */
    .exploded {
      overflow: hidden;
    }

    .exploded__svg {
      width: 130%;
      max-width: none;
      margin-left: -1%;
    }
  }
</style>
