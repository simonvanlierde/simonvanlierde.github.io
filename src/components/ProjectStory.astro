---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { ImageMetadata } from "astro";
import cardImages from "../data/cardImages.json" with { type: "json" };
import { participants, statsSource } from "../data/figures.ts";
import { figureParts } from "../data/projectSchema.ts";
import stats from "../data/stats.json" with { type: "json" };
import DisassemblyChart from "./DisassemblyChart.tsx";
import Figure from "./Figure.astro";
import ProjectMetadata from "./ProjectMetadata.astro";
import SourceRecord from "./SourceRecord.astro";

const {
  project,
  standalone = false,
  primaryActions = true,
} = Astro.props as { project: CollectionEntry<"projects">; standalone?: boolean; primaryActions?: boolean };
const Heading = standalone ? "h2" : "h3";
const { id, data } = project;
const assets = import.meta.glob<{ default: ImageMetadata }>("../assets/cards/*", { eager: true });
const image = (cardImages as Record<string, { file: string }>)[id];
const imageSrc = image && assets[`../assets/cards/${image.file}`]?.default;
const firstTeardown = stats.series.find((row) => row.teardowns > 0)?.label;
const totals = [
  ["Products documented", stats.totals.teardowns],
  ["Components catalogued", stats.totals.parts],
  ["Images captured", stats.totals.images],
] as const;
---

<div class="project-story" data-project-story={id}>
  {primaryActions && <ul class="story-actions story-primary-actions">
    {data.demo && <li><a href={data.demo}>Open {data.title}</a></li>}
    <li><a href={data.repo}>Source</a></li>
  </ul>}
  {id === "r9lab" ? <>
    <p>Industrial ecology has little data on what products are made of. R9lab records it by taking durable goods apart, component by component. I designed and built the platform, and CML now uses it.</p>
    <p>It has a FastAPI backend, a PostgreSQL data model for life-cycle assessment, and an Expo / React Native capture app. In use at CML since {firstTeardown}, including two teardown workshops.</p>
    <Heading>From products to open data</Heading>
    <p>Researchers and students collect parts, materials and photos in an open platform, with an API for using the records in other studies.</p>
    <div class="r9lab__chart">
      <DisassemblyChart caption="R9lab running totals" client:load />
    </div>
    <dl class="story-totals">
      {totals.map(([label, value]) => <div><dt>{label}</dt><dd><Figure value={value.toLocaleString("en-US")} source={statsSource} as_of={stats.as_of} /></dd></div>)}
      <div><dt>Workshop participants</dt><dd><Figure {...participants} /></dd></div>
    </dl>
    <p class="story-source">Products, components and images: <a href={statsSource}>platform snapshot</a>, <time datetime={stats.as_of}>{stats.as_of}</time>. Participants: <a href={participants.source}>pilot workshops</a>, <time datetime={participants.as_of}>{participants.as_of}</time>.</p>
    <SourceRecord sourceId="r9lab-totals" label="R9lab totals" />
    <SourceRecord sourceId="r9lab-series" label="R9lab monthly series" />
    <Heading>Use and check the work</Heading>
    <ul class="story-actions">
      <li><a href="https://docs.r9lab.io">Documentation</a></li>
      <li><a href="https://github.com/CMLPlatform/r9cam">Raspberry Pi camera plugin</a></li>
      <li><a href="https://doi.org/10.5281/zenodo.16637742">Zenodo record</a></li>
      <li><a href="https://scorecard.dev/viewer/?uri=github.com/CMLPlatform/r9lab">OpenSSF Scorecard</a></li>
      <li><a href="https://www.bestpractices.dev/projects/14492">OpenSSF Best Practices</a></li>
    </ul>
  </> : <>
    <p class="story-description">{figureParts(data.description, data.figures).map((part) => typeof part === "string" ? part : <Figure {...part} />)}</p>
    {imageSrc && <figure class="story-preview"><Image src={imageSrc} alt={`${data.title} interface`} width={640} loading="lazy" /></figure>}
    {data.links.length > 0 && <ul class="story-actions">{data.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul>}
    {Object.entries(data.figures ?? {}).length > 0 && <details class="story-evidence"><summary>Sources and dates</summary><ul>{Object.entries(data.figures ?? {}).map(([label, figure]) => <li><a href={figure.source}>{label}: {figure.value}</a> · <time datetime={figure.as_of}>{figure.as_of}</time></li>)}</ul></details>}
  </>}
  <ProjectMetadata repo={data.repo} />
  {data.tags.length > 0 && <p class="story-technologies">{data.tags.join(" · ")}</p>}
</div>

<style>
  .project-story { font: 400 18px/1.6 var(--font-sans); width: 100%; min-width: 0; container-type: inline-size; container-name: story; }
  .project-story > p { max-width: 75ch; }
  .project-story p + p { margin-top: 16px; }
  h2, h3 { font: italic 25px/1.2 var(--font-sans); margin-block: 32px 12px; text-wrap: balance; }
  .r9lab__chart { container-type: inline-size; container-name: chart; margin-block: 24px; }
  .story-totals { display: grid; margin-top: 24px; column-gap: 28px; }
  .story-totals > div { display: flex; justify-content: space-between; gap: 16px; padding-block: 8px; border-bottom: 1px solid var(--rule); }
  dd { font-variant-numeric: tabular-nums; }
  .story-source, .story-technologies { font-size: 14px; line-height: 1.5; color: var(--ink-2); margin-top: 16px; }
  .story-actions { display: flex; flex-wrap: wrap; gap: 0 24px; list-style: none; padding: 0; margin-block: 16px; }
  .story-primary-actions { margin-top: 0; }
  .story-actions a { display: inline-flex; align-items: center; min-height: 44px; }
  .story-preview { margin: 24px 0; }
  .story-preview img { display: block; width: 100%; height: auto; }
  .story-evidence { font-size: 15px; margin-block: 16px; }
  .story-evidence summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; text-decoration: underline; text-underline-offset: 4px; }
  .story-evidence ul { padding-left: 18px; }
  @container story (min-width: 34rem) {
    .story-totals, .story-actions:not(.story-primary-actions) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .story-actions > li { min-width: 0; }
  }
  @container story (min-width: 40rem) {
    .project-story > p:not(.story-source):not(.story-technologies) { font-size: 20px; }
  }
  :global([data-theme="dark"]) .story-preview img { filter: brightness(0.88); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .story-preview img { filter: brightness(0.88); } }
</style>
