---
// ISO 7200 title block, one per sheet. Every cell is real provenance. There is
// no scale cell: nothing on a web page is drawn to scale.
import { cv, profiles } from "../data/cv.ts";
import { formatIsoDate } from "./cvPeriod.ts";

interface Props {
  /** Document title, e.g. the person's name. */
  title: string;
  /** What this sheet is, e.g. "Index of work" / "Curriculum vitae". */
  docType: string;
  sheet: string; // e.g. "1 OF 2"
  /** ISO date the sheet's data was last generated, if known. */
  dated?: string;
  /** The other sheet in the set: makes the sheet number turn the page. */
  turn?: { href: string; label: string; dir: "next" | "prev" };
}

const { title, docType, sheet, dated, turn } = Astro.props;
const datedLabel = dated ? formatIsoDate(dated) : null;

// Email first, then the same profile list the hero uses.
const { basics } = cv;

// The commit this build came from, set in astro.config.mjs.
const sha: string = import.meta.env.SITE_SHA;
const repoUrl = "https://github.com/simonvanlierde/simonvanlierde.github.io";
const contact = [...(basics.email ? [{ label: basics.email, href: `mailto:${basics.email}` }] : []), ...profiles];
---

<footer class="container">
  <section class="title-block" aria-label="Document title block">
    <div class="title-block__cell">
      <span class="title-block__label">Title</span>
      <span class="title-block__value">{title}</span>
    </div>
    <div class="title-block__cell">
      <span class="title-block__label">Document</span>
      <span class="title-block__value">{docType}</span>
    </div>
    <div class="title-block__cell">
      <span class="title-block__label">Sheet</span>
      <span class="title-block__value">
        {
          turn ? (
            <a
              class:list={["title-block__turn", `title-block__turn--${turn.dir}`]}
              href={turn.href}
              aria-label={`${sheet}, go to ${turn.label}`}
            >
              {sheet}
              <svg class="title-block__arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </a>
          ) : (
            sheet
          )
        }
      </span>
    </div>
    <div class="title-block__cell">
      <span class="title-block__label">{dated ? "Dated" : "Drawn by"}</span>
      <span class="title-block__value">
        {dated ? <time datetime={dated}>{datedLabel}</time> : "SVL"}
      </span>
    </div>
    <div class="title-block__cell title-block__cell--contact">
      <span class="title-block__label" id="contact-label">Contact Simon</span>
      <ul class="title-block__value title-block__contact" aria-labelledby="contact-label">
        {
          contact.map((c) => (
            <li>
              <a href={c.href}>{c.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="title-block__cell">
      {/* "Site rev", not "Rev": on the CV sheet a bare revision reads as the
          CV's own version. Every push to main deploys, so the commit is the
          revision. */}
      <span class="title-block__label">Site rev</span>
      <span class="title-block__value">
        <a href={`${repoUrl}/commit/${sha}`} aria-label={`Site revision ${sha.slice(0, 7)}, view the commit on GitHub`}>
          {sha.slice(0, 7)}
        </a>
      </span>
    </div>
  </section>
</footer>
