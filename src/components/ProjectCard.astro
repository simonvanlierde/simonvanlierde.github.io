---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import cardImages from "../data/cardImages.json" with { type: "json" };
import { type CardLink, type Figure as FigureData, figureParts } from "../data/projectSchema.ts";
import Figure from "./Figure.astro";

// One parts-list row. Only the title links the repo, so the description
// stays selectable.
interface Props {
  id: string;
  related?: { uses: CardLink[]; usedBy: CardLink[] };
  title: string;
  description: string;
  repo: string;
  kind: string;
  demo?: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  figures?: Record<string, FigureData>;
  featured?: boolean;
}

const { id, related, title, description, repo, kind, demo, tags = [], links = [], figures, featured } = Astro.props;
const relations = [
  { label: "Uses", cards: related?.uses ?? [] },
  { label: "Used by", cards: related?.usedBy ?? [] },
].filter((r) => r.cards.length > 0);

// A featured card shows a close-up of its demo, cut by `pnpm fetch:cards` (or made by hand; see
// docs/architecture.md). Without one it is a plain row like the rest.
const assets = import.meta.glob<{ default: ImageMetadata }>("../assets/cards/*", { eager: true });
const image = featured ? (cardImages as Record<string, { file: string }>)[id] : undefined;
const imageSrc = image && assets[`../assets/cards/${image.file}`]?.default;
if (image && !imageSrc) throw new Error(`${id}: src/assets/cards/${image.file} is missing; run pnpm fetch:cards`);
const shot = demo && imageSrc;
---

<article class={shot ? "bom-row bom-row--feature" : "bom-row bom-row--part"} id={`project-${id}`}>
  <p class="bom-row__pos">{kind}</p>
  <div class="bom-row__body">
    <h3 class="bom-row__title">
      <a href={repo}>{title}</a>
    </h3>
    {
      /* Under the name when stacked, in its own column when wide. A shortcut
         to the demo for pointer users, hidden from the keyboard and screen
         readers: "Live demo" below is the same link, with a name. The files
         are 480px, twice the 15rem it shows at. */
      shot && (
        <a class="bom-row__shot" href={demo} tabindex="-1" aria-hidden="true">
          <Image src={imageSrc} alt="" width={240} densities={[1, 2]} />
        </a>
      )
    }
    <p class="bom-row__desc">
      {
        figureParts(description, figures).map((part) =>
          typeof part === "string" ? part : <Figure {...part} />,
        )
      }
    </p>

    {
      /* No "Source" link: the title already links the repo. Each aria-label
         names the project, so the links stay distinct in a screen reader. */
      (demo || links.length > 0) && (
        <p class="bom-row__links">
          {demo && (
            <a class="bom-row__demo" href={demo} aria-label={`Live demo of ${title}`}>
              Live demo
            </a>
          )}
          {links.map((l) => (
            <a href={l.url} aria-label={`${l.label} for ${title}`}>
              {l.label}
            </a>
          ))}
        </p>
      )
    }

    {
      (relations.length > 0 || tags.length > 0) && (
      <div class="bom-row__spec">
        {
          relations.length > 0 && (
            <p class="ref-list">
              {relations.map((r) => (
                <span class="ref-list__group">
                  <span class="ref-list__label">{r.label}</span>
                  {r.cards.map((c) => (
                    <a class="ref" href={c.href ?? `#project-${c.id}`}>
                      {c.title}
                    </a>
                  ))}
                </span>
              ))}
            </p>
          )
        }

        {
          tags.length > 0 && (
            <ul class="tag-list" aria-label="Technologies">
              {tags.map((t) => (
                <li class="tag">{t}</li>
              ))}
            </ul>
          )
        }
      </div>
      )
    }
  </div>
</article>
