---
import { type CardLink, type Figure as FigureData, figureParts } from "../data/projectSchema.ts";
import Figure from "./Figure.astro";

// One parts-list row. Only the title links the repo, so the description
// stays selectable.
interface Props {
  id: string;
  related?: { builtWith: CardLink[]; usedBy: CardLink[] };
  title: string;
  description: string;
  repo: string;
  kind: string;
  demo?: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  figures?: Record<string, FigureData>;
}

const { id, related, title, description, repo, kind, demo, tags = [], links = [], figures } = Astro.props;
const relations = [
  { label: "Built with", cards: related?.builtWith ?? [] },
  { label: "Used by", cards: related?.usedBy ?? [] },
].filter((r) => r.cards.length > 0);
---

<article class="bom-row" id={`project-${id}`}>
  <p class="bom-row__pos">{kind}</p>
  <div class="bom-row__body">
    <h3 class="bom-row__title">
      <a href={repo}>{title}</a>
    </h3>
    <p class="bom-row__desc">
      {
        figureParts(description, figures).map((part) =>
          typeof part === "string" ? part : <Figure {...part} />,
        )
      }
    </p>


    {
      /* No "Source" link: the title already links the repo. Each aria-label
         names the project, so the links stay distinct in a screen reader. */
      (demo || links.length > 0) && (
        <p class="bom-row__links">
          {demo && (
            <a href={demo} aria-label={`Live demo of ${title}`}>
              Live demo
            </a>
          )}
          {links.map((l) => (
            <a href={l.url} aria-label={`${l.label} for ${title}`}>
              {l.label}
            </a>
          ))}
        </p>
      )
    }

    {relations.map((r) => (
      <p class="bom-row__links bom-row__rel">
        <span class="bom-row__rel-label">{r.label}</span>
        {r.cards.map((c) => (
          <a href={`#project-${c.id}`}>{c.title}</a>
        ))}
      </p>
    ))}

    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label="Technologies">
          {tags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
