---
// One row of the bill of materials: position balloon, kind, part, spec.
// The whole row is a click target (the title link stretches over it);
// secondary links sit above the stretched link.
interface Props {
  /** Position number in the bill of materials. */
  pos: number;
  title: string;
  description: string;
  repo: string;
  kind?: string;
  demo?: string;
  tags?: string[];
  links?: { label: string; url: string }[];
}

const { pos, title, description, repo, kind, demo, tags = [], links = [] } = Astro.props;

// The kind cell says what the thing is, so the column can be scanned on its
// own. It falls back to the leading tag, which is then dropped from the tag
// list: one value in two places on the same row is noise.
const [lead, ...rest] = tags;
const rail = kind ?? lead;
const railTags = kind ? tags : rest;
---

<article class="bom-row">
  <p class="bom-row__pos">
    <span class="balloon" aria-hidden="true">{pos}</span>
    <span class="bom-row__kind">{rail}</span>
  </p>
  <div class="bom-row__body">
    <h3 class="bom-row__title">
      <a href={repo}>{title}</a>
    </h3>
    <p class="bom-row__desc">{description}</p>

    {
      /* No "Source" link: the title already links the repo. The links here
         name their project, which is what a screen reader's link list needs. */
      (demo || links.length > 0) && (
        <p class="bom-row__links">
          {demo && (
            <a href={demo} aria-label={`Live demo of ${title}`}>
              Live demo
            </a>
          )}
          {links.map((l) => (
            <a href={l.url} aria-label={`${l.label} for ${title}`}>
              {l.label}
            </a>
          ))}
        </p>
      )
    }

    {
      railTags.length > 0 && (
        <ul class="tag-list" aria-label="Technologies">
          {railTags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
