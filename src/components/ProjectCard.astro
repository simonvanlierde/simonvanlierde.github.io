---
// One parts-list row. Only the title links the repo, so the description
// stays selectable. A grouped row has no repo of its own: each of its `parts`
// links its repo by name instead.
interface Props {
  title: string;
  description: string;
  repo?: string;
  kind: string;
  demo?: string;
  tags?: string[];
  links?: { label: string; url: string }[];
  parts?: {
    name: string;
    what: string;
    repo: string;
    demo?: string;
    ci?: string;
    links?: { label: string; url: string }[];
  }[];
}

const { title, description, repo, kind, demo, tags = [], links = [], parts = [] } = Astro.props;
---

<article class="bom-row">
  <p class="bom-row__pos">{kind}</p>
  <div class="bom-row__body">
    <h3 class="bom-row__title">
      {repo ? <a href={repo}>{title}</a> : title}
    </h3>
    <p class="bom-row__desc">{description}</p>

    {
      parts.length > 0 && (
        <ul class="bom-parts">
          {parts.map((part) => (
            <li class="bom-parts__item">
              <a class="bom-parts__name" href={part.repo}>
                {part.name}
              </a>
              <p class="bom-parts__what">{part.what}</p>
              <p class="bom-parts__links">
                {part.demo && (
                  <a class="bom-parts__demo" href={part.demo} aria-label={`Live demo of ${part.name}`}>
                    Live demo
                  </a>
                )}
                {part.ci && (
                  <a href={part.ci} aria-label={`CI runs for ${part.name}`}>
                    CI runs
                  </a>
                )}
                {(part.links ?? []).map((l) => (
                  <a href={l.url} aria-label={`${l.label} for ${part.name}`}>
                    {l.label}
                  </a>
                ))}
              </p>
            </li>
          ))}
        </ul>
      )
    }

    {
      /* No "Source" link: the title already links the repo. Each aria-label
         names the project, so the links stay distinct in a screen reader. */
      (demo || links.length > 0) && (
        <p class="bom-row__links">
          {demo && (
            <a href={demo} aria-label={`Live demo of ${title}`}>
              Live demo
            </a>
          )}
          {links.map((l) => (
            <a href={l.url} aria-label={`${l.label} for ${title}`}>
              {l.label}
            </a>
          ))}
        </p>
      )
    }

    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label="Technologies">
          {tags.map((t) => (
            <li class="tag">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
