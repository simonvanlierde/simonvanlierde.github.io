---
import { plainWhat, prGroups, type upstreamShowcase } from "../data/upstream.ts";

interface Props {
  groups: typeof upstreamShowcase;
  /** The archive's full entries with PR links; otherwise one line per library. */
  details?: boolean;
}
const { groups, details = false } = Astro.props;
const anchor = (name: string) => `upstream-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---
{details ? (
<ul class="upstream-list">
  {groups.map((group) => (
    <li id={anchor(group.name)}>
      <h3>{group.name}</h3>
      {group.projects.map((project) => (
        <p>{group.projects.length > 1 && <span class="draft">{project.name}: </span>}{plainWhat(project)}</p>
      ))}
      {group.projects.map((project) => (
        <p class="upstream-prs"><span class="draft">{project.name}: </span>
          {prGroups(project).map((part, i) => <>
            {i > 0 && "; "}
            {part.prs.map((n, j) => <>{j > 0 && ", "}<a href={`https://github.com/${project.repo}/pull/${n}`}>#{n}</a></>)}
            {part.base && ` merged into the ${part.base} branch`}
          </>)}
        </p>
      ))}
    </li>
  ))}
</ul>
) : (
<ul class="upstream-lines">
  {groups.map((group) => (
    <li>
      <a class="upstream-lines__name" href={`/archive/#${anchor(group.name)}`}>{group.name}</a>
      <p>{group.projects.length > 1 && <span class="draft">{group.lead.project.repo.split("/")[1]}: </span>}{group.lead.text}</p>
    </li>
  ))}
</ul>
)}
