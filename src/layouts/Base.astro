---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** schema.org JSON-LD for this page. Built in src/data/schemaOrg.ts. */
  jsonLd?: object;
}

const { title, description, jsonLd } = Astro.props;

// Astro.site is set in astro.config.mjs (https://simonvanlierde.github.io).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Browser chrome only takes a literal colour. The literal is the light
        paper --bg; the theme script below rewrites it from the computed
        background once the stylesheet is in, so it always matches --bg. */}
    <meta name="theme-color" content="#f8f7f3" />
    <meta name="color-scheme" content="light dark" />

    {/* The drafting lettering carries the first paint of every heading. */}
    <link rel="preload" href="/fonts/osifont.woff2" as="font" type="font/woff2" crossorigin />

    {/* Apply the saved theme before paint to avoid a flash. */}
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t) document.documentElement.dataset.theme = t;
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    {
      /* Structured data: lets a publication be read as a publication rather
         than as a heading. */
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script is:inline>
      const btn = document.querySelector(".theme-toggle");
      const meta = document.querySelector('meta[name="theme-color"]');
      const media = matchMedia("(prefers-color-scheme: dark)");

      const isDark = () =>
        document.documentElement.dataset.theme
          ? document.documentElement.dataset.theme === "dark"
          : media.matches;

      // Keep browser chrome and the toggle icon in step with the active theme.
      // btn is optional: this layout may wrap a page without a toggle.
      const sync = () => {
        const dark = isDark();
        // The chrome colour is whatever --bg resolved to; no literal to drift.
        meta.content = getComputedStyle(document.body).backgroundColor;
        btn?.setAttribute("aria-pressed", String(dark));
      };

      btn?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("theme", next);
        sync();
      });

      // Follow system changes only while the user hasn't picked a theme.
      media.addEventListener("change", () => {
        if (!localStorage.getItem("theme")) sync();
      });

      sync();
    </script>
  </body>
</html>
