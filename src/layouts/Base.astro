---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** schema.org JSON-LD for this page. Built in src/data/schemaOrg.ts. */
  jsonLd?: object;
  /** False on pages with no address of their own (the 404 page), so they claim no canonical URL. */
  canonical?: boolean;
}

const { title, description, jsonLd, canonical: hasCanonical = true } = Astro.props;

// Astro.site is set in astro.config.mjs (https://simonvanlierde.com).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`og.png?v=${import.meta.env.OG_VERSION}`, Astro.site);
const ogImageAlt =
  "Simon van Lierde, research software engineer for industrial ecology, with his portrait beside an exploded drawing of a software system.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {hasCanonical && <link rel="canonical" href={canonical} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="BEI1tU9v8_DvNV4d3XjLj_E-Y-L7cIE0oVi-fozlfe4" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Technical notes" href="/notes/rss.xml" />
    <meta name="theme-color" content="#f2f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10171a" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <link rel="preload" href="/fonts/schibsted-grotesk-latin-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/newsreader-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />

    {/* Apply the saved theme before paint to avoid a flash. */}
    <script is:inline>
      // Blocked storage leaves the system theme in control.
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Simon van Lierde" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
          is:inline
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script is:inline>
      const btn = document.querySelector(".theme-toggle");
      const metas = document.querySelectorAll('meta[name="theme-color"]');
      const systemTheme = matchMedia("(prefers-color-scheme: dark)");

      // Blocked storage stops the toggle remembering the theme, not applying it.
      const remember = (v) => {
        try {
          localStorage.setItem("theme", v);
        } catch {}
      };

      const isDark = () => {
        const saved = document.documentElement.dataset.theme;
        return saved ? saved === "dark" : systemTheme.matches;
      };

      // Computed styles serialise --bg as oklch(), which theme-color parsers
      // may not accept. A 1px canvas converts it to plain sRGB.
      const ctx = document.createElement("canvas").getContext("2d", { willReadFrequently: true });
      const toRgb = (color) => {
        if (!ctx) return color;
        ctx.fillStyle = color;
        ctx.fillRect(0, 0, 1, 1);
        const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
        return `rgb(${r}, ${g}, ${b})`;
      };

      // btn is optional: some pages have no toggle.
      const sync = () => {
        const dark = isDark();
        const color = toRgb(getComputedStyle(document.body).backgroundColor);
        metas.forEach((meta) => { meta.content = color; });
        btn?.setAttribute("aria-pressed", String(dark));
      };

      btn?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        remember(next);
        sync();
      });

      sync();
      systemTheme.addEventListener("change", sync);
    </script>
  </body>
</html>
