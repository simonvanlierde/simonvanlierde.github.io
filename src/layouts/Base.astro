---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** schema.org JSON-LD for this page. Built in src/data/schemaOrg.ts. */
  jsonLd?: object;
  /** False on pages with no address of their own (the 404 page), so they claim no canonical URL. */
  canonical?: boolean;
}

const { title, description, jsonLd, canonical: hasCanonical = true } = Astro.props;

// Astro.site is set in astro.config.mjs (https://simonvanlierde.com).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {hasCanonical && <link rel="canonical" href={canonical} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="BEI1tU9v8_DvNV4d3XjLj_E-Y-L7cIE0oVi-fozlfe4" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Dark --bg (the default theme) as a fallback; the script at the end of
        body syncs it to the active theme. */}
    <meta name="theme-color" content="#19263f" />
    <meta name="color-scheme" content="dark light" />

    {/* Every heading uses osifont on first paint. */}
    <link rel="preload" href="/fonts/osifont.woff2" as="font" type="font/woff2" crossorigin />

    {/* Apply the saved theme before paint to avoid a flash. */}
    <script is:inline>
      // Storage throws where blocked (sandboxed iframe, strict privacy modes);
      // the default dark theme applies instead.
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Simon van Lierde" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
          is:inline
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script is:inline>
      const btn = document.querySelector(".theme-toggle");
      const meta = document.querySelector('meta[name="theme-color"]');

      // Blocked storage stops the toggle remembering the theme, not applying it.
      const remember = (v) => {
        try {
          localStorage.setItem("theme", v);
        } catch {}
      };

      // Dark unless the visitor picked light; global.css sets the same default.
      const isDark = () => document.documentElement.dataset.theme !== "light";

      // Computed styles serialise --bg as oklch(), which theme-color parsers
      // may not accept. A 1px canvas converts it to plain sRGB.
      const ctx = document.createElement("canvas").getContext("2d", { willReadFrequently: true });
      const toRgb = (color) => {
        if (!ctx) return color;
        ctx.fillStyle = color;
        ctx.fillRect(0, 0, 1, 1);
        const [r, g, b] = ctx.getImageData(0, 0, 1, 1).data;
        return `rgb(${r}, ${g}, ${b})`;
      };

      // btn is optional: some pages have no toggle.
      const sync = () => {
        const dark = isDark();
        meta.content = toRgb(getComputedStyle(document.body).backgroundColor);
        btn?.setAttribute("aria-pressed", String(dark));
      };

      btn?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        remember(next);
        sync();
      });

      sync();
    </script>
  </body>
</html>
