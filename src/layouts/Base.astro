---
import CspScript from "../components/CspScript.astro";
import themeInit from "../scripts/themeInit.js?raw";
import themeToggle from "../scripts/themeToggle.js?raw";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** schema.org JSON-LD for this page. Built in src/data/schemaOrg.ts. */
  jsonLd?: object;
  /** False on pages with no address of their own (the 404 page), so they claim no canonical URL. */
  canonical?: boolean;
}

const { title, description, jsonLd, canonical: hasCanonical = true } = Astro.props;

// Astro.site is set in astro.config.mjs (https://simonvanlierde.com).
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`og.png?v=${import.meta.env.OG_VERSION}`, Astro.site);
const ogImageAlt =
  "Simon van Lierde, research software engineer for industrial ecology, with his portrait beside an exploded drawing of a software system.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {hasCanonical && <link rel="canonical" href={canonical} />}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="BEI1tU9v8_DvNV4d3XjLj_E-Y-L7cIE0oVi-fozlfe4" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Technical notes" href="/notes/rss.xml" />
    {/* Dark --bg (the default theme) as a fallback; the script at the end of
        body syncs it to the active theme. */}
    <meta name="theme-color" content="#19263f" />
    <meta name="color-scheme" content="dark light" />

    {/* Every heading uses osifont on first paint. */}
    <link rel="preload" href="/fonts/osifont.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Simon van Lierde" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
          is:inline
        />
      )
    }
  </head>
  <body>
    {/* Apply the saved theme before paint to avoid a flash. */}
    <CspScript code={themeInit} />
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <CspScript code={themeToggle} />
  </body>
</html>
