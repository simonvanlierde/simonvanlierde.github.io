  .c-rows :global(.bom-row__pos),
  .c-rows :global(.archive-link),
  .c-rows :global(.upstream-lines p),
  .c-rows :global(.r9-notes dt),
  .c-rows :global(.r9-notes__foot),
  .c-rows :global(.tag),
  .c-rows :global(.ref-list__label),
  .c-rows :global(.project-meta) {
    color: var(--c-muted);
  }

  .c-rows :global(.tag) {
    border-color: var(--c-rule);
  }

  .c-rows :global(.bom-row__shot img) {
    background: none;
    border-color: var(--c-rule);
