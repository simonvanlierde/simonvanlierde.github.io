    font-size: var(--step--1);
    color: var(--c-muted);
  }

  /* Scroll-linked: the core is pulled whole and breaks into runs as the reader
     goes down it. Longhands, see global.css. Without support, or with reduced
     motion, the runs lie apart. */
  .c-stratum + .c-stratum {
    margin-top: 1.1rem;
  }

  @keyframes c-break {
    from {
      translate: 0 calc(var(--i) * -1.1rem);
    }
