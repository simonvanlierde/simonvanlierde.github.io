  }

  .c-rows :global(.datum) {
    color: var(--c-ink);
    background: none;
    border-color: var(--c-ink);
  }

  .c-rows :global(.upstream-lines > li) {
    grid-template-columns: minmax(0, 1fr);
    border-color: var(--c-rule);
  }

  .c-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-l) clamp(1rem, 3vw, 2.5rem) 5rem;
    border-top: 1.5px solid var(--c-ink);
    font: var(--step--1) var(--font-draft);
    color: var(--c-muted);
  }

  /* Narrow: the core tray. Each run lies flat in its box, its tags below it,
     and the runs part as the tray comes into view. */
  @media (max-width: 63.99rem) {
    .c-cols {
      display: none;
    }

    .c-sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .c-slot::after {
      display: none;
    }

    .c-stratum {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas:
        "unit unit"
        "core core"
        "left right";
      gap: 0 0.6rem;
      padding-bottom: 0.6rem;
      border: 1.5px solid var(--c-ink);
      border-top: 0;
    }

    .c-stratum:first-child {
      border-top: 1.5px solid var(--c-ink);
    }

    .c-stratum + .c-stratum {
      margin-top: 0;
    }

    .c-unit {
      display: flex;
      justify-content: space-between;
    }

    .c-segment {
      height: 2.4rem;
      margin-inline: 0.5rem;
      border: 1.5px solid var(--c-ink);
      border-radius: 1.2rem / 50%;
    }

    .c-segment::after {
      background: linear-gradient(
        180deg,
        oklch(0% 0 0 / 0.22),
        oklch(100% 0 0 / 0.12) 38%,
        oklch(0% 0 0 / 0) 60%,
        oklch(0% 0 0 / 0.28)
      );
    }

    .c-segment::before,
    .c-segment::after {
      border-radius: inherit;
    }

    .c-tags {
      padding-inline: 0.5rem;
    }

    .c-tags--left,
    .c-tags--left .c-group,
    .c-tags--left .c-group__list {
      justify-items: start;
    }

    .c-tags--left .c-slot {
      flex-direction: row;
    }

    .c-tags--left .c-tag {
      padding: 0 0.55rem 0 1.15rem;
      clip-path: polygon(0.45rem 0, 100% 0, 100% 100%, 0.45rem 100%, 0 calc(100% - 0.45rem), 0 0.45rem);
    }

    .c-tags--left .c-tag::before {
      inset-inline: 0.4rem auto;
    }

    .c-tag {
      min-height: 44px;
      max-width: 100%;
    }

    .c-tag__t {
      overflow-wrap: anywhere;
    }

    .c-detail {
      width: 44px;
      height: 44px;
    }

    @keyframes c-break-narrow {
      from {
        translate: calc(var(--i) * -0.6rem) 0;
        opacity: 0.6;
      }
    }

    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        .c-stratum {
          animation-name: c-break-narrow;
          animation-timeline: view();
          animation-range: entry 0% cover 30%;
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .c-tag {
      transition:
        color var(--dur-fast) ease,
        background-color var(--dur-fast) ease;
    }

    .c-tag.is-focus {
      animation: none;
    }
  }
</style>

