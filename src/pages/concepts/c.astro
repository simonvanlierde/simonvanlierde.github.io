  .c-rows > h2 {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 0.3rem;
    border-block: 1.5px solid var(--c-ink);
    font-size: var(--step-1);
  }

  .c-rows__col {
