---
import { formatIsoDate, formatPeriod } from "../components/cvPeriod.ts";
import SheetHead from "../components/SheetHead.astro";
import SheetNav from "../components/SheetNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { cv, cvPdf as pdf } from "../data/cv.ts";
import { listablePublications } from "../data/publications.ts";
import { cvJsonLd } from "../data/schemaOrg.ts";
import Base from "../layouts/Base.astro";

const {
  basics,
  profile,
  skills,
  experience,
  projects,
  education,
  professional_development: development,
  interests,
  exported,
} = cv;

// Accepted work always lists; unaccepted work only once it has a DOI.
const publications = listablePublications(cv.publications);

const exportedLabel = exported ? formatIsoDate(exported) : null;

// Letters follow the rendered sections, so hidden sections leave no gaps.
// Each section heading shows the same letter as the zone index.
const sections = [
  { id: "profile-heading", label: "Profile", show: true },
  { id: "experience-heading", label: "Experience", show: true },
  { id: "publications-heading", label: "Publications", show: publications.length > 0 },
  { id: "education-heading", label: "Education", show: true },
  { id: "projects-heading", label: "Projects", show: projects.length > 0 },
  { id: "skills-heading", label: "Skills", show: skills.length > 0 },
  { id: "development-heading", label: "Talks and training", show: development.length > 0 },
  { id: "interests-heading", label: "Interests", show: interests.length > 0 },
]
  .filter((s) => s.show)
  .map((s, i) => ({ ...s, ref: String.fromCharCode(65 + i) }));
const ref = (id: string) => sections.find((s) => s.id === id)?.ref;
---

<Base
  title={`CV | ${basics.name}`}
  description={`Curriculum vitae of ${basics.name}: ${basics.headline}.`}
  jsonLd={cvJsonLd}
>
  <SheetNav current="cv" />

  {/* Skip target: the skip link passes only the sheet nav. */}
  <header class="container cv-header" id="main">
    {/* Same split as the index's hero: the title zone and the stamp on the
        left, the section register where the index has its figure. */}
    <div class="cv-header__grid">
      <div class="cv-header__intro">
        {/* The name, not "Curriculum vitae": a print or screenshot has to say whose. */}
        <SheetHead />

        <a class="stamp sheet-stamp" href={pdf} download>
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <path d="M7 10l5 5 5-5"></path>
            <path d="M12 15V3"></path>
          </svg>
          Download as PDF
        </a>

        {
          exportedLabel && (
            <p class="cv-updated">
              Last updated <time datetime={exported}>{exportedLabel}</time>
            </p>
          )
        }
      </div>

      <nav class="cv-index" aria-label="Sections">
        <p class="cv-index__instruction">Go to any lettered section.</p>
        <ol class="cv-index__list">
          {
            sections.map((sec) => (
              <li>
                <a href={`#${sec.id}`}>
                  <span class="datum" aria-hidden="true">
                    {sec.ref}
                  </span>
                  {sec.label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </header>

  <main>
    <section class="container" aria-labelledby="profile-heading">
      <h2 id="profile-heading"><span class="datum" aria-hidden="true">{ref("profile-heading")}</span>Profile</h2>
      <p class="prose cv-profile cv-aligned">{profile}</p>
    </section>

    <section class="container" aria-labelledby="experience-heading">
      <h2 id="experience-heading"><span class="datum" aria-hidden="true">{ref("experience-heading")}</span>Experience</h2>
      <div class="cv-entries">
        {
          experience.map((job) => (
            <article class="cv-entry">
              {/* The rail period is hidden from screen readers; the heading
                  carries it instead, so heading navigation hears the dates. */}
              <p class="cv-entry__period" aria-hidden="true">{formatPeriod(job.start, job.end)}</p>
              <div class="cv-entry__body">
                <h3 class="cv-entry__role">
                  {job.role}
                  <span class="visually-hidden">, {formatPeriod(job.start, job.end)}</span>
                </h3>
                <p class="cv-entry__org">{job.organization}</p>
                {job.highlights.length > 0 && (
                  <ul class="cv-highlights">
                    {job.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      /* After Experience: an academic reader looks here first. */
      publications.length > 0 && (
        <section class="container" aria-labelledby="publications-heading">
          <h2 id="publications-heading"><span class="datum" aria-hidden="true">{ref("publications-heading")}</span>Publications</h2>
          <div class="cv-entries">
            {publications.map((pub) => (
              <article class="cv-entry">
                <p class="cv-entry__period" aria-hidden="true">{pub.year}</p>
                <div class="cv-entry__body">
                  <h3 class="cv-entry__role">
                    {pub.doi ? <a href={`https://doi.org/${pub.doi}`}>{pub.title}</a> : pub.title}
                    <span class="visually-hidden">, {pub.year}</span>
                  </h3>
                  <p class="cv-entry__org">{pub.authors.join(", ")}</p>
                  <p class="cv-publication__venue">
                    {pub.venue}
                    {pub.status !== "published" && <span class="tag">{pub.status}</span>}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="container" aria-labelledby="education-heading">
      <h2 id="education-heading"><span class="datum" aria-hidden="true">{ref("education-heading")}</span>Education</h2>
      <div class="cv-entries">
        {
          education.map((school) => (
            <article class="cv-entry">
              <p class="cv-entry__period" aria-hidden="true">{formatPeriod(school.start, school.end)}</p>
              <div class="cv-entry__body">
                <h3 class="cv-entry__role">
                  {school.degree}
                  <span class="visually-hidden">, {formatPeriod(school.start, school.end)}</span>
                </h3>
                <p class="cv-entry__org">{school.institution}</p>
                {school.details && <p class="cv-entry__detail">{school.details}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      projects.length > 0 && (
        <section class="container" aria-labelledby="projects-heading">
          <h2 id="projects-heading"><span class="datum" aria-hidden="true">{ref("projects-heading")}</span>Projects</h2>
          <div class="cv-entries">
            {projects.map((project) => (
              <article class="cv-entry cv-entry--railless">
                <div class="cv-entry__body">
                  <h3 class="cv-entry__role">
                    {project.url ? <a href={project.url}>{project.name}</a> : project.name}
                  </h3>
                  {project.summary && <p class="cv-entry__org">{project.summary}</p>}
                  {project.highlights.length > 0 && (
                    <ul class="cv-highlights">
                      {project.highlights.map((h) => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      /* Optional sections render only when they have content. */
      skills.length > 0 && (
        <section class="container" aria-labelledby="skills-heading">
          <h2 id="skills-heading"><span class="datum" aria-hidden="true">{ref("skills-heading")}</span>Skills</h2>
          <div class="cv-entries">
            {skills.map((group) => (
              <div class="cv-entry">
                <p class="cv-entry__period">{group.group}</p>
                <p class="cv-entry__body cv-skills">{group.items.join(", ")}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      development.length > 0 && (
        <section class="container" aria-labelledby="development-heading">
          <h2 id="development-heading"><span class="datum" aria-hidden="true">{ref("development-heading")}</span>Talks and training</h2>
          <ul class="prose cv-list cv-aligned">
            {development.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      interests.length > 0 && (
        <section class="container" aria-labelledby="interests-heading">
          <h2 id="interests-heading"><span class="datum" aria-hidden="true">{ref("interests-heading")}</span>Interests</h2>
          <p class="prose cv-interests cv-aligned">{interests.join(", ")}</p>
        </section>
      )
    }

    <aside class="container cv-download-utility" aria-label="PDF download">
      <p class="prose">Generated from the same source as this page.</p>
      {/* Plain link: the header holds the sheet's one stamp. */}
      <a class="draft cv-download-utility__link" href={pdf} download>Download as PDF</a>
    </aside>
  </main>

  <TitleBlock
    title={basics.name}
    docType="Curriculum vitae"
    sheet="2 OF 2"
    turn={{ href: "/", label: "sheet 1, index", dir: "prev" }}
    dated={exported?.slice(0, 10)}
  />
</Base>

<style>
  .cv-header {
    padding-block: var(--space-l) var(--space-m);
  }

  .cv-header__grid {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  .cv-index__instruction {
    margin-bottom: var(--space-xs);
    color: var(--text-muted);
    font-family: var(--font-draft);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
  }

  /* A register of fixed columns at every width: two on a phone, four once
     they fit, so each row starts on the same line instead of wherever the
     previous label ran out. */
  .cv-index__list {
    list-style: none;
    padding: 0;
    display: grid;
    /* Shrinkable, so on the narrowest phones a long label wraps in its
       column instead of pushing the second column off the sheet. */
    grid-template-columns: repeat(2, minmax(0, max-content));
    gap: var(--space-2xs) var(--space-m);
    font-family: var(--font-draft);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  @media (min-width: 42rem) {
    .cv-index__list {
      grid-template-columns: repeat(4, max-content);
      column-gap: var(--space-l);
    }

    .cv-index__list a {
      white-space: nowrap;
    }
  }

  /* Beside the title zone, in the column the index gives its figure, the
     register runs down one column. */
  @media (min-width: 60rem) {
    .cv-header__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    }

    .cv-index__list {
      grid-template-columns: max-content;
    }
  }

  .cv-index__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--text-muted);
    text-decoration: none;
    padding-inline: 0.25rem;
    margin-inline: -0.25rem;
  }

  .cv-index__list a:hover {
    color: var(--accent);
  }

  .cv-index__list a:hover .datum {
    border-color: var(--accent);
    color: var(--accent);
  }

  main h2 .datum {
    margin-inline-end: var(--space-s);
    vertical-align: 0.1em;
    letter-spacing: 0;
  }

  /* 11rem rail + gutter: aligns prose with the entries' body column. */
  @media (min-width: 40rem) {
    .cv-aligned {
      margin-inline-start: calc(11rem + var(--space-l));
    }
  }

  .cv-updated {
    margin-top: var(--space-s);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .cv-profile {
    margin-top: var(--space-m);
  }

  .cv-skills {
    max-width: var(--measure);
  }

  .cv-publication__venue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .cv-entry__detail {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
    max-width: var(--measure);
  }

  .cv-list {
    margin-top: var(--space-l);
    padding-left: 1.1em;
  }

  .cv-list li + li {
    margin-top: var(--space-xs);
  }

  .cv-interests {
    margin-top: var(--space-l);
  }

  .cv-download-utility {
    margin-top: var(--space-m);
    padding-block: var(--space-s);
    border-top: var(--border-width) solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .cv-download-utility__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.65rem;
    margin-block: -0.65rem;
  }

  @media print {
    @page {
      margin: 12mm 14mm;
    }

    body {
      padding: 0;
    }

    .cv-header {
      padding-block: 0 0.75rem;
    }

    main > section {
      padding-block: 0.75rem 1rem;
    }

    .cv-entries {
      margin-top: 0.9rem;
      gap: 0.9rem;
    }

    .cv-highlights {
      margin-top: 0.4rem;
    }

    .cv-highlights li + li {
      margin-top: 0.15rem;
    }

    /* Without the zone index, the heading letters point at nothing. */
    .sheet-stamp,
    .cv-index,
    .cv-download-utility,
    main h2 .datum {
      display: none;
    }

    /* Print URLs after link text. Email links already show the address. */
    .cv-entry__role a::after,
    :global(.title-block__contact a:not([href^="mailto:"]))::after {
      content: " (" attr(href) ")";
      font-size: 0.85em;
      overflow-wrap: anywhere;
    }
  }
</style>
