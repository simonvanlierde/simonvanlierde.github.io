---
import { formatPeriod } from "../components/cvPeriod.ts";
import SheetNav from "../components/SheetNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { cv, cvPdf as pdf } from "../data/cv.ts";
import { listablePublications } from "../data/publications.ts";
import { cvJsonLd } from "../data/schemaOrg.ts";
import Base from "../layouts/Base.astro";

const {
  basics,
  profile,
  skills,
  experience,
  projects,
  education,
  professional_development: development,
  interests,
  exported,
} = cv;

// A CV with no date makes the reader guess how stale it is. Day precision is
// the useful granularity. Accepted work always lists; unaccepted work only
// once a preprint DOI exists (see listablePublications and tests/unit).
const publications = listablePublications(cv.publications);

const exportedLabel = exported
  ? new Date(exported).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric",
      // The title block prints the same stamp as `exported.slice(0, 10)` (UTC);
      // a local-zone build near midnight would otherwise disagree by a day.
      timeZone: "UTC",
    })
  : null;

// The email entry drops out entirely when the export withholds it, rather
// than rendering a dead "mailto:undefined".
const contact = [
  { label: basics.location, href: null },
  ...(basics.email ? [{ label: basics.email, href: `mailto:${basics.email}` }] : []),
  { label: "GitHub", href: basics.links.github },
  { label: "LinkedIn", href: basics.links.linkedin },
];
---

<Base
  title={`CV | ${basics.name}`}
  description={`Curriculum vitae of ${basics.name}: ${basics.headline}.`}
  jsonLd={cvJsonLd}
>
  <SheetNav current="cv" />

  {/* The skip link lands here, not on <main>: the h1, the download stamp and
      the contact list are content, only the sheet nav is chrome to bypass. */}
  <header class="container cv-header" id="main">
    {/* The name, not "Curriculum vitae": a print or a screenshot of the top of
        this page has to carry whose CV it is. The document type is already in
        the tab title, the download button, and the title block. */}
    <h1>{basics.name}</h1>
    <p class="cv-header__headline prose">{basics.headline}</p>

    <ul class="link-list cv-contact">
      {
        contact.map((c) => (
          <li>{c.href ? <a href={c.href}>{c.label}</a> : <span class="draft">{c.label}</span>}</li>
        ))
      }
    </ul>

    <a class="stamp cv-download" href={pdf} download>
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <path d="M7 10l5 5 5-5"></path>
        <path d="M12 15V3"></path>
      </svg>
      Download as PDF
    </a>

    {
      /* Sits under the download button because it dates both: page and PDF
         come out of one export run. */
      exportedLabel && (
        <p class="cv-updated">
          Last updated <time datetime={exported}>{exportedLabel}</time>
        </p>
      )
    }
  </header>

  <main>
    <section class="container" aria-labelledby="profile-heading">
      <h2 id="profile-heading">Profile</h2>
      <p class="prose cv-profile">{profile}</p>
    </section>

    <section class="container" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <div class="cv-entries">
        {
          experience.map((job) => (
            <article class="cv-entry">
              <p class="cv-entry__period">{formatPeriod(job.start, job.end)}</p>
              <div class="cv-entry__body">
                <h3 class="cv-entry__role">{job.role}</h3>
                <p class="cv-entry__org">{job.organization}</p>
                {job.highlights.length > 0 && (
                  <ul class="cv-highlights">
                    {job.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      /* Directly after Experience: it is the section an academic reader looks
         for first. */
      publications.length > 0 && (
        <section class="container" aria-labelledby="publications-heading">
          <h2 id="publications-heading">Publications</h2>
          <div class="cv-entries">
            {publications.map((pub) => (
              <article class="cv-entry">
                <p class="cv-entry__period">{pub.year}</p>
                <div class="cv-entry__body">
                  <h3 class="cv-entry__role">
                    {pub.doi ? <a href={`https://doi.org/${pub.doi}`}>{pub.title}</a> : pub.title}
                  </h3>
                  <p class="cv-entry__org">{pub.authors.join(", ")}</p>
                  <p class="cv-publication__venue">
                    {pub.venue}
                    {pub.status !== "published" && <span class="tag">{pub.status}</span>}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      /* Optional sections render or they don't. An empty heading over nothing
         reads as a gap in the person, not a gap in the export. */
      skills.length > 0 && (
        <section class="container" aria-labelledby="skills-heading">
          <h2 id="skills-heading">Skills</h2>
          <div class="cv-entries">
            {skills.map((group) => (
              <div class="cv-entry">
                <p class="cv-entry__period">{group.group}</p>
                <ul class="tag-list cv-entry__body" aria-label={group.group}>
                  {group.items.map((item) => (
                    <li class="tag">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section class="container" aria-labelledby="projects-heading">
          <h2 id="projects-heading">Projects</h2>
          <div class="cv-entries">
            {projects.map((project) => (
              <article class="cv-entry">
                <div class="cv-entry__body cv-entry__body--railless">
                  <h3 class="cv-entry__role">
                    <a href={project.url}>{project.name}</a>
                  </h3>
                  <p class="cv-entry__org">{project.summary}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    <section class="container" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <div class="cv-entries">
        {
          education.map((school) => (
            <article class="cv-entry">
              <p class="cv-entry__period">{formatPeriod(school.start, school.end)}</p>
              <div class="cv-entry__body">
                <h3 class="cv-entry__role">{school.degree}</h3>
                <p class="cv-entry__org">{school.institution}</p>
                {school.details && <p class="cv-entry__detail">{school.details}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      /* Talks, summer schools, and upstream contributions: the section a
         reading committee looks for. */
      development.length > 0 && (
        <section class="container" aria-labelledby="development-heading">
          <h2 id="development-heading">Talks and training</h2>
          <ul class="prose cv-list">
            {development.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      interests.length > 0 && (
        <section class="container" aria-labelledby="interests-heading">
          <h2 id="interests-heading">Interests</h2>
          <ul class="tag-list cv-interests" aria-labelledby="interests-heading">
            {interests.map((item) => (
              <li class="tag">{item}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="container" aria-labelledby="cv-download-heading">
      <h2 id="cv-download-heading">Download</h2>
      <div class="cv-footer-download">
        <p class="prose">The PDF is generated from the same source as this page.</p>
        {/* The sheet's one stamp is the header's download; this repeat is a
            plain working link. */}
        <a class="draft" href={pdf} download>Download as PDF</a>
      </div>
    </section>
  </main>

  <TitleBlock
    title={basics.name}
    docType="Curriculum vitae"
    sheet="2 OF 2"
    dated={exported?.slice(0, 10)}
  />
</Base>

<style>
  .cv-header {
    padding-block: var(--space-l) var(--space-m);
  }

  /* Shared with the landing page's h1: navigating between sheets morphs the
     name instead of cross-fading the whole document. */
  .cv-header h1 {
    view-transition-name: person-name;
  }

  /* The headline in full ink over the muted contact row: the CV's opening
     two blocks must not read as one grey mass. */
  .cv-header__headline {
    margin-top: var(--space-s);
    font-size: var(--step-1);
    color: var(--text);
  }

  .cv-contact {
    margin-top: var(--space-m);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .cv-download {
    margin-top: var(--space-l);
  }

  .cv-updated {
    margin-top: var(--space-s);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .cv-profile {
    margin-top: var(--space-m);
    color: var(--text-muted);
  }

  /* Venue sits under the byline, with the status chip only when it isn't
     "published": absence already means accepted. */
  .cv-publication__venue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .cv-entry__detail {
    margin-top: var(--space-2xs);
    color: var(--text-muted);
    font-size: var(--step--1);
    max-width: var(--measure);
  }

  .cv-list {
    margin-top: var(--space-l);
    padding-left: 1.1em;
    color: var(--text-muted);
  }

  .cv-list li + li {
    margin-top: var(--space-xs);
  }

  .cv-interests {
    margin-top: var(--space-l);
  }

  .cv-footer-download {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m) var(--space-l);
  }
</style>
