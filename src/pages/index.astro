---
import { getCollection } from "astro:content";
import ProjectStory from "../components/ProjectStory.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WorkMap from "../components/WorkMap.svelte";
import { cv, intro } from "../data/cv.ts";
import { figureText } from "../data/projectSchema.ts";
import { homeJsonLd } from "../data/schemaOrg.ts";
import Base from "../layouts/Base.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Base title={`${cv.basics.name} | Research software engineer for industrial ecology`} description={intro} jsonLd={homeJsonLd(projects.filter((p) => p.data.featured))}>
  <SiteHeader current="index" />
  <main id="main" tabindex="-1" class="container map-home">
    <WorkMap mission="I contribute open tools and data to industrial ecology and the circular economy, for anyone to use, check and add to." projects={projects.map((p) => ({ id: p.id, ...p.data, description: figureText(p.data.description, p.data.figures), href: `/projects/${p.id}/` }))} client:load>
      <div class="project-stories">
        {projects.map((project) => <ProjectStory project={project} primaryActions={false} />)}
      </div>
    </WorkMap>
  </main>
  <SiteFooter />
</Base>

<style>
  .map-home { min-height: calc(100svh - 176px); }
  @media (min-width: 1080px) {
    :global(body:has(.map-home) .container) { width: calc(100% - 2 * var(--gutter)); }
  }
</style>
