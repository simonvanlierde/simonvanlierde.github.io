---
import { getCollection } from "astro:content";
import { formatCount as fmt } from "../components/chartScale.ts";
import DisassemblyChart from "../components/DisassemblyChart.tsx";
import ExplodedView from "../components/ExplodedView.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SheetNav from "../components/SheetNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { cv, profiles } from "../data/cv.ts";
import { personJsonLd } from "../data/schemaOrg.ts";
import stats from "../data/stats.json" with { type: "json" };
import Base from "../layouts/Base.astro";

// The history lives on /cv/; this sheet reads only the basics and the date.
const { basics, exported } = cv;

// Same payload as the chart, refreshed by scripts/fetch-stats.mjs.
const counts = { as_of: stats.as_of, ...stats.totals };
// The first month with a teardown: when the platform went into use.
const firstTeardown = stats.series.find((row) => row.teardowns > 0)?.label;
const asOfLabel = new Date(counts.as_of).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
// NOTE: not in the /stats payload; counted at the two workshops, kept by hand.
const participants = 135;
const notes = [
  { ref: "A", label: "Products documented", value: fmt(counts.teardowns) },
  { ref: "B", label: "Components catalogued", value: fmt(counts.parts) },
  { ref: "C", label: "Images captured", value: fmt(counts.images) },
  { ref: "D", label: "Workshop participants", value: fmt(participants) },
];

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const workProjects = allProjects.filter((p) => p.data.category === "work");
const personalProjects = allProjects.filter((p) => p.data.category === "personal");

const name = basics.name;

// Matches the start of the CV headline.
const lead = "PhD researcher and research software engineer";

const tagline =
  "At CML, Leiden University, I build open, reproducible research infrastructure for industrial ecology and the circular economy, currently around product disassembly.";

// Puts dated evidence on the first screen; the notes below have the full counts.
const proof = `ReLab to date: ${fmt(counts.teardowns)} products taken apart, ${fmt(counts.parts)} components catalogued (${asOfLabel}).`;
---

<Base
  title={`${name} | PhD researcher & Research Software Engineer`}
  description={tagline}
  jsonLd={personJsonLd}
>
  <SheetNav current="index" />

  {/* Skip target. A div, not <main>: a header inside <main> loses its banner role. */}
  <div id="main">
  <header class="container hero">
    <div class="hero__grid">
      <div class="hero__intro">
        <h1>{name}</h1>
        <p class="lead">{lead}</p>
        <p class="tagline prose">{tagline}</p>
        <p class="hero__proof draft"><a href="#relab">{proof}</a></p>

        <div class="hero__actions">
          <a class="stamp" href="/cv/">
            Curriculum vitae<span class="visually-hidden">, sheet 2</span>
          </a>
          {
            basics.email && (
              <a class="hero__email draft" href={`mailto:${basics.email}`}>
                {basics.email}
              </a>
            )
          }
        </div>

        {/* Repeats the title block's profiles, which sit at the end of a long
            sheet. Muted, so the stamp stays the one primary action. */}
        <ul class="hero__profiles link-list draft" aria-label="Profiles">
          {
            profiles.map((p) => (
              <li>
                <a href={p.href}>{p.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__figure">
        <ExplodedView />
      </div>
    </div>
  </header>

  <main>
    <section class="container" aria-labelledby="work-heading">
      <h2 id="work-heading">Selected work</h2>
      <div class="bom">
        <article class="bom-row relab-row" id="relab">
          <p class="bom-row__pos">Research platform</p>
          <div class="bom-row__body">
            <h3 class="bom-row__title relab-row__title">
              <a href="https://github.com/CMLPlatform/relab">ReLab</a>
            </h3>
            <div class="relab-row__intro prose">
              <p>
                ReLab closes a product-data gap in industrial ecology by
                recording how durable goods come apart, component by component.
                I designed and built the platform now used at CML: a FastAPI
                backend, a PostgreSQL data model for life-cycle assessment, and
                an Expo / React Native capture app.
              </p>
              <p>In use at CML since {firstTeardown}, including two teardown workshops.</p>
            </div>
            <ul class="bom-row__links link-list">
              <li><a href="https://app.cml-relab.org">Live platform</a></li>
              <li><a href="https://docs.cml-relab.org">Documentation</a></li>
              <li>
                <a href="https://github.com/CMLPlatform/relab-rpi-cam-plugin">
                  Raspberry Pi camera plugin
                </a>
              </li>
            </ul>

            <section class="notes" aria-labelledby="notes-heading">
              <h4 id="notes-heading" class="notes__heading">
                Notes A–D<span class="notes__heading-aside"> · running totals</span>
              </h4>
              <ol class="notes__list">
                {
                  notes.map((n) => (
                    <li>
                      <span class="datum" aria-hidden="true">
                        {n.ref}
                      </span>
                      <span class="notes__value draft">{n.value}</span>
                      <span class="notes__label">{n.label}</span>
                    </li>
                  ))
                }
              </ol>
              <p class="notes__foot draft">As counted {asOfLabel}.</p>
            </section>

            <div class="relab__chart">
              <DisassemblyChart caption="Fig. 2: ReLab running totals" client:visible />
            </div>
          </div>
        </article>

        {
          workProjects.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              repo={p.data.repo}
              kind={p.data.kind}
              demo={p.data.demo}
              tags={p.data.tags}
              links={p.data.links}
            />
          ))
        }
      </div>

      <p class="upstream-note">
        Currently prototyping an <a href="https://github.com/simonvanlierde/ai4ie-demo">AI4IE resource hub</a> and a <a href="https://github.com/CMLPlatform/cml-gallery">project gallery</a> for CML. I also send fixes upstream to tools I build on, mostly in the FastAPI and open-LCA ecosystems, such as <a href="https://github.com/sabuhish/fastapi-mail/pull/283">fastapi-mail</a> and <a href="https://github.com/sentier-dev/sentier_data_tools/pull/2">sentier_data_tools</a>.
      </p>

      <details class="disclosure personal" open>
        <summary>
          <h3>Personal projects ({personalProjects.length})</h3>
        </summary>
        <div class="bom">
          {
            personalProjects.map((p) => (
              <ProjectCard
                title={p.data.title}
                description={p.data.description}
                repo={p.data.repo}
                kind={p.data.kind}
                demo={p.data.demo}
                tags={p.data.tags}
                links={p.data.links}
              />
            ))
          }
        </div>
      </details>
    </section>

  </main>
  </div>

  {/* Date by the newer input, so the title block is never older than a figure on the page. */}
  <TitleBlock
    title={name}
    docType="Index of work"
    sheet="1 OF 2"
    dated={[exported?.slice(0, 10), stats.as_of].filter(Boolean).sort().at(-1)}
  />
</Base>

<style>
  .hero {
    padding-block: var(--space-l) var(--space-xl);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  @media (min-width: 60rem) {
    /* Top-aligned, so the name sits at the same height as on the CV. */
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      align-items: start;
    }

    .hero__figure {
      justify-self: end;
      width: 100%;
    }
  }

  .hero__actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .hero__email {
    color: var(--text-muted);
    letter-spacing: 0.03em;
    overflow-wrap: anywhere;
    padding-block: 0.65rem; /* 44px target */
    margin-block: -0.65rem;
  }

  .hero__email:hover {
    color: var(--accent-strong);
  }

  .hero__proof {
    margin-top: var(--space-m);
    max-width: var(--measure);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
  }

  .hero__proof a {
    color: var(--text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .hero__proof a:hover {
    color: var(--accent-strong);
  }

  .hero__profiles {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    gap: 0 var(--space-m);
  }

  .hero__profiles a {
    color: var(--text-muted);
  }

  .hero__profiles a:hover {
    color: var(--accent-strong);
  }

  .notes {
    margin-top: var(--space-l);
    max-width: var(--measure);
    padding: var(--space-s) var(--space-m) var(--space-m);
    border: var(--border-width) solid var(--border-strong);
  }

  .notes__heading {
    font-family: var(--font-draft);
    font-weight: 400;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    padding-bottom: var(--space-2xs);
    border-bottom: var(--border-width) solid var(--border-strong);
  }

  .notes__heading-aside {
    color: var(--text-muted);
  }

  .notes__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s) var(--space-m);
  }

  .notes__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-s);
    align-content: start;
  }

  /* One step below the h1, so the counts do not compete with the name. */
  .notes__value {
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--text);
  }

  .notes__label {
    grid-column: 2;
    font-family: var(--font-draft);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .notes__foot {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  /* ReLab's title outranks the repo names below it. */
  .relab-row__title {
    font-size: var(--step-2);
  }

  .relab-row__intro {
    color: var(--text-muted);
  }

  /* An inline-size container cannot size from its content, so it needs an
     explicit width: the plot's 30rem cap (see DisassemblyChart.css). */
  .relab__chart {
    container: chart / inline-size;
    width: 100%;
    max-width: 30rem;
    margin-top: var(--space-l);
  }

  .upstream-note {
    margin-top: var(--space-l);
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .disclosure {
    margin-top: var(--space-xl);
  }

  .disclosure summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
    min-height: 44px;
    padding-block: var(--space-s);
  }

  .disclosure summary::-webkit-details-marker {
    display: none;
  }

  .disclosure summary::before {
    content: "";
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .disclosure[open] summary::before {
    transform: rotate(45deg);
  }

  .disclosure summary h3 {
    color: inherit;
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .disclosure {
        interpolate-size: allow-keywords;
      }

      .disclosure::details-content {
        block-size: 0;
        overflow: hidden;
        opacity: 0;
        transition:
          block-size var(--dur-slow) var(--ease-out),
          content-visibility var(--dur-slow) allow-discrete,
          opacity var(--dur-base) ease;
      }

      .disclosure[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure summary::before {
      transition: none;
    }
  }
</style>
