---
import { getCollection } from "astro:content";
import DisassemblyChart from "../components/DisassemblyChart.tsx";
import ExplodedView from "../components/ExplodedView.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SheetNav from "../components/SheetNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { cv } from "../data/cv.ts";
import { personJsonLd } from "../data/schemaOrg.ts";
import stats from "../data/stats.json" with { type: "json" };
import Base from "../layouts/Base.astro";

// The history lives on /cv/; this sheet reads only the basics and the date.
const { basics, exported } = cv;

// stats.json is refreshed by scripts/fetch-stats.mjs; until live data lands
// it is a seeded sample. `sample` is optional by hand: the first live export
// deletes the key. Sample data never ships; the dev server may draw it.
const { sample: statsAreSample = false, ...statsData } = stats as typeof stats & { sample?: boolean };
const showChart = !statsAreSample || import.meta.env.DEV;

// General notes: RELab's running counts. Live figures share the chart's
// payload; while it is sample, the last hand-counted, dated totals stand in.
// NOTE: update `fallback` when a newer count is known.
const fallback = { as_of: "2026-08-01", products: 78, parts: 1331, images: 3610 };
const counts = statsAreSample ? fallback : { as_of: statsData.as_of, ...statsData.totals };
const fmt = (n: number) => n.toLocaleString("en-US").replace(/,/g, "\u2009");
const asOfLabel = new Date(counts.as_of).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
// NOTE: not in the /stats payload; counted at the two workshops, kept by hand.
const participants = 135;
const notes = [
  { ref: "A", label: "Products documented", value: fmt(counts.products) },
  { ref: "B", label: "Components catalogued", value: fmt(counts.parts) },
  { ref: "C", label: "Images captured", value: fmt(counts.images) },
  { ref: "D", label: "Workshop participants", value: fmt(participants) },
];

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const workProjects = allProjects.filter((p) => p.data.category === "work");
const personalProjects = allProjects.filter((p) => p.data.category === "personal");

const name = basics.name;

// The thesis line is the career-wide claim, not the current project.
const question = "Open software and open data for sustainability research.";

const tagline =
  "PhD researcher and research software engineer at CML, Leiden University. I build open, reproducible research infrastructure for industrial ecology and the circular economy, currently around product disassembly.";

// One stamp per sheet: the CV. The address is a plain link beside it.
const profiles = [
  { label: "GitHub", href: basics.links.github },
  { label: "LinkedIn", href: basics.links.linkedin },
  { label: "ORCID", href: "https://orcid.org/0009-0006-6953-909X" },
  {
    label: "Leiden profile",
    href: "https://www.universiteitleiden.nl/en/staffmembers/simon-van-lierde",
  },
];
---

<Base
  title={`${name} | PhD researcher & Research Software Engineer`}
  description={tagline}
  jsonLd={personJsonLd}
>
  <SheetNav current="index" />

  {/* Skip target. A div, not <main>: a header inside <main> loses its banner role. */}
  <div id="main">
  <header class="container hero">
    <div class="hero__grid">
      <div class="hero__intro">
        <h1>{name}</h1>
        <p class="hero__question">{question}</p>
        <p class="hero__tagline prose">{tagline}</p>

        <div class="hero__actions">
          <a class="stamp" href="/cv/">
            Curriculum vitae<span class="visually-hidden">, sheet 2</span>
          </a>
          {
            basics.email && (
              <a class="hero__email draft" href={`mailto:${basics.email}`}>
                {basics.email}
              </a>
            )
          }
        </div>

        <ul class="link-list hero__profiles" aria-label="Profiles">
          {
            profiles.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>

        <section class="notes" aria-labelledby="notes-heading">
          <h2 id="notes-heading" class="notes__heading">
            Notes<span class="notes__heading-aside"> · RELab, running totals</span>
          </h2>
          <p class="notes__lead draft">
            One of the projects below; Fig. 1 draws its parts.
          </p>
          <ol class="notes__list">
            {
              notes.map((n) => (
                <li>
                  <span class="datum" aria-hidden="true">
                    {n.ref}
                  </span>
                  <span class="notes__value draft">{n.value}</span>
                  <span class="notes__label">{n.label}</span>
                </li>
              ))
            }
          </ol>
          <p class="notes__foot draft">
            All quantities as counted {asOfLabel} ·&nbsp;<a href="https://app.cml-relab.org">CML&nbsp;RELab</a>
          </p>
        </section>
      </div>

      <div class="hero__figure">
        <ExplodedView />
      </div>
    </div>
  </header>

  <main>
    <section class="container" aria-labelledby="work-heading">
      <h2 id="work-heading">Selected work</h2>
      <div class="bom">
        {/* RELab first: the platform, with the chart when data is live */}
        <article class="bom-row relab-row">
          <p class="bom-row__pos">Research platform</p>
          <div class="bom-row__body">
            <h3 class="bom-row__title relab-row__title">
              <a href="https://github.com/CMLPlatform/relab">Reverse Engineering Lab (RELab)</a>
            </h3>
            <div class="relab-row__intro prose">
              <p>
                Research infrastructure I designed and built: a FastAPI backend,
                a PostgreSQL data model for life-cycle assessment, and an Expo /
                React Native frontend. RELab collects disassembly data on
                durable goods to close a long-standing product-data gap in
                industrial ecology.
              </p>
              <p>In active use at CML, including two teardown workshops.</p>
            </div>
            <ul class="bom-row__links link-list">
              <li><a href="https://app.cml-relab.org">Live platform</a></li>
              <li><a href="https://docs.cml-relab.org">Documentation</a></li>
              <li>
                <a href="https://github.com/CMLPlatform/relab-rpi-cam-plugin">
                  RPI camera plugin
                </a>
              </li>
            </ul>

            {
              showChart && (
                <div class="relab__chart">
                  <h4 class="draft">Fig. 2: Disassembly over time</h4>
                  <p class="viz__caption">Activity in RELab by month.</p>
                  <DisassemblyChart stats={statsData} isSample={statsAreSample} client:visible />
                </div>
              )
            }
          </div>
        </article>

        {
          workProjects.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              repo={p.data.repo}
              kind={p.data.kind}
              demo={p.data.demo}
              tags={p.data.tags}
              links={p.data.links}
            />
          ))
        }
      </div>

      <p class="prose upstream-note">
        Currently prototyping an <a href="https://github.com/simonvanlierde/ai4ie-demo">AI4IE resource hub</a> and a <a href="https://github.com/CMLPlatform/cml-gallery">project gallery</a> for CML. I also send fixes upstream to tools I build on, mostly in the FastAPI and open-LCA ecosystems, such as <a href="https://github.com/sabuhish/fastapi-mail/pull/283">fastapi-mail</a> and <a href="https://github.com/sentier-dev/sentier_data_tools/pull/2">sentier_data_tools</a>.
      </p>

      <details class="disclosure personal">
        <summary>
          <h3>Personal projects ({personalProjects.length})</h3>
        </summary>
        <div class="bom">
          {
            personalProjects.map((p) => (
              <ProjectCard
                title={p.data.title}
                description={p.data.description}
                repo={p.data.repo}
                kind={p.data.kind}
                demo={p.data.demo}
                tags={p.data.tags}
                links={p.data.links}
              />
            ))
          }
        </div>
      </details>
    </section>

    <section class="container closing" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <div class="closing__body">
        <p class="prose">Collaboration, roles, or questions about RELab and the tooling behind it:</p>
        {
          <p class="closing__row draft">
            {basics.email && <a href={`mailto:${basics.email}`}>{basics.email}</a>}
            <a href="/cv/">Sheet 2: CV</a>
          </p>
        }
      </div>
    </section>
  </main>
  </div>

  <TitleBlock
    title={name}
    docType="Index of work"
    sheet="1 OF 2"
    dated={exported?.slice(0, 10)}
  />
</Base>

<style>
  .hero {
    padding-block: var(--space-l) var(--space-xl);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    }

    /* The plate sits beside the text and notes. */
    .hero__figure {
      justify-self: end;
      width: 100%;
    }
  }

  .hero h1 {
    /* Shared with the CV page's h1, so the name morphs between the two sheets
       rather than cross-fading with the rest of the document. */
    view-transition-name: person-name;
  }

  /* The question is the page's thesis: full ink, one step below the name. */
  .hero__question {
    max-width: 30rem;
    margin-top: var(--space-m);
    font-family: var(--font-draft);
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: 0.01em;
    text-wrap: balance;
    color: var(--text);
  }

  .hero__tagline {
    margin-top: var(--space-m);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .hero__actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .hero__email {
    color: var(--text-muted);
    letter-spacing: 0.03em;
    overflow-wrap: anywhere;
    padding-block: 0.65rem; /* 44px target */
    margin-block: -0.65rem;
  }

  .hero__email:hover {
    color: var(--accent-strong);
  }

  .hero__profiles {
    margin-top: var(--space-m);
    font-size: var(--step--1);
  }

  /* General notes: one project's running counts, in the first viewport. */
  .notes {
    margin-top: var(--space-l);
    max-width: 36rem;
  }

  .notes__lead {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    max-width: 30rem;
  }

  .notes__heading {
    font-family: var(--font-draft);
    font-weight: 400;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    padding-bottom: var(--space-2xs);
    border-bottom: var(--border-width) solid var(--border-strong);
  }

  .notes__heading-aside {
    color: var(--text-muted);
  }

  .notes__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s) var(--space-m);
  }

  .notes__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-s);
    align-content: start;
  }

  .notes__value {
    font-size: var(--step-3);
    line-height: 1.05;
    color: var(--text);
  }

  .notes__label {
    grid-column: 2;
    font-family: var(--font-draft);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .notes__foot {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .notes__foot a {
    padding-block: 0.65rem;
    margin-block: -0.65rem;
  }

  /* Lead row: the platform's title outranks the repo slugs below it. */
  .relab-row__title {
    font-size: var(--step-2);
  }

  .relab-row__intro {
    color: var(--text-muted);
  }

  /* An inline-size container cannot size from its content, so it takes an
     explicit width: the plot's own 30rem cap (see DisassemblyChart.css). */
  .relab__chart {
    container: chart / inline-size;
    width: 100%;
    max-width: 30rem;
  }

  .relab__chart h4 {
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .viz__caption {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-l);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .upstream-note {
    margin-top: var(--space-l);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .disclosure {
    margin-top: var(--space-xl);
  }

  .disclosure summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
    min-height: 44px;
    padding-block: var(--space-s);
  }

  .disclosure summary::-webkit-details-marker {
    display: none;
  }

  .disclosure summary::before {
    content: "";
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .disclosure[open] summary::before {
    transform: rotate(45deg);
  }

  .disclosure summary h3 {
    color: inherit;
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .disclosure {
        interpolate-size: allow-keywords;
      }

      .disclosure::details-content {
        block-size: 0;
        overflow: hidden;
        opacity: 0;
        transition:
          block-size var(--dur-slow) var(--ease-out),
          content-visibility var(--dur-slow) allow-discrete,
          opacity var(--dur-base) ease;
      }

      .disclosure[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure summary::before {
      transition: none;
    }
  }

  .closing__body {
    margin-top: var(--space-l);
  }

  .closing__row {
    margin-top: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .closing__row a {
    padding-block: 0.65rem;
    margin-block: -0.65rem;
    overflow-wrap: anywhere;
  }
</style>
