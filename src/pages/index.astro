---
import { getCollection } from "astro:content";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WorkIndex from "../components/WorkIndex.astro";
import { cv, intro } from "../data/cv.ts";
import { homeJsonLd } from "../data/schemaOrg.ts";
import Base from "../layouts/Base.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Base title={`${cv.basics.name} | Research software engineer for industrial ecology`} description={intro} jsonLd={homeJsonLd(projects.filter((p) => p.data.featured))}>
  <SiteHeader current="index" />
  <main id="main" tabindex="-1" class="container">
    <WorkIndex mission="I contribute open tools and data to industrial ecology and the circular economy, for anyone to use, check and add to." projects={projects} />
  </main>
  <SiteFooter />
</Base>
