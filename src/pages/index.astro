---
import { getCollection } from "astro:content";
import { formatPeriod } from "../components/cvPeriod.ts";
import DisassemblyChart from "../components/DisassemblyChart.tsx";
import ExplodedView from "../components/ExplodedView.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SheetNav from "../components/SheetNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { cv } from "../data/cv.ts";
import { personJsonLd } from "../data/schemaOrg.ts";
import stats from "../data/stats.json" with { type: "json" };
import Base from "../layouts/Base.astro";

// The condensed history below renders from the same cv-public.yaml as /cv/, so
// the two pages can't drift. Highlights are dropped here: this is the timeline
// you skim, /cv/ is the one you read.
const { basics, experience, education, exported } = cv;

// `stats.json` is refreshed from the RELab /stats endpoint by a scheduled
// workflow (scripts/fetch-stats.mjs). Until that lands it holds seeded sample
// figures, flagged via `sample`; sample data never ships to a visitor, so the
// chart block is absent until the figures are real.
const { sample: statsAreSample = false, ...statsData } = stats;

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const workProjects = allProjects.filter((p) => p.data.category === "work");
const personalProjects = allProjects.filter((p) => p.data.category === "personal");

const name = "Simon van Lierde";

// The thesis line carries the career-wide identity, not the current PhD
// project: open software and open data for sustainability research. RELab
// stays where it belongs, as position 1 in the bill of materials, and the
// exploded figure illustrates the wider method rather than one platform.
const question = "Open software and open data for sustainability research.";

const tagline =
  "PhD researcher and research software engineer at CML, Leiden University. I build open, reproducible research infrastructure for industrial ecology and the circular economy, currently around product disassembly.";

// Profile links, drawn as a notes list in the hero. Exactly one stamp (the
// primary action) per sheet: email when the export carries an address, the
// CV otherwise.
const profiles = [
  { label: "GitHub", href: "https://github.com/simonvanlierde" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/simon-van-lierde/" },
  { label: "ORCID", href: "https://orcid.org/0009-0006-6953-909X" },
  {
    label: "Leiden profile",
    href: "https://www.universiteitleiden.nl/en/staffmembers/simon-van-lierde",
  },
];
---

<Base
  title={`${name} | PhD researcher & Research Software Engineer`}
  description={tagline}
  jsonLd={personJsonLd}
>
  <SheetNav current="index" />

  <header class="container hero">
    <div class="hero__grid">
      <div class="hero__intro">
        <h1>{name}</h1>
        <p class="hero__question">{question}</p>
        <p class="hero__tagline prose">{tagline}</p>

        <div class="hero__actions">
          {
            basics.email ? (
              <a class="stamp" href={`mailto:${basics.email}`}>
                Contact
              </a>
            ) : (
              <a class="stamp" href="/cv/">
                Curriculum vitae
              </a>
            )
          }
          {
            /* The address in plain text beside the stamp: a mailto: alone
               strands anyone without a configured mail client. */
            basics.email && <span class="hero__email draft">{basics.email}</span>
          }
        </div>

        <ul class="link-list hero__profiles" aria-label="Profiles">
          {
            profiles.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__figure">
        <ExplodedView />
      </div>
    </div>
  </header>

  <main id="main">
    <section class="container" aria-labelledby="work-heading">
      <h2 id="work-heading">Bill of materials · Selected work</h2>
      <div class="bom">
        <!-- Position 1: RELab, the platform, with the chart when data is live -->
        <article class="bom-row relab-row">
          <p class="bom-row__pos">
            <span class="balloon" aria-hidden="true">1</span>
            <span class="bom-row__kind">Research platform</span>
          </p>
          <div class="bom-row__body">
            <h3 class="bom-row__title relab-row__title">
              <a href="https://github.com/CMLPlatform/relab">Reverse Engineering Lab (RELab)</a>
            </h3>
            <div class="relab-row__intro prose">
              <p>
                Research infrastructure I designed and built: a FastAPI backend,
                a PostgreSQL data model for life-cycle assessment, and an Expo /
                React Native frontend. RELab collects disassembly data on
                durable goods to close a long-standing product-data gap in
                industrial ecology.
              </p>
              <p>
                In active use at CML, including two teardown workshops with 135
                participants; the counts in Fig. 1 are its running totals.
              </p>
            </div>
            <ul class="bom-row__links link-list">
              <li><a href="https://app.cml-relab.org">Live platform</a></li>
              <li><a href="https://docs.cml-relab.org">Documentation</a></li>
              <li>
                <a href="https://github.com/CMLPlatform/relab-rpi-cam-plugin">
                  RPI camera plugin
                </a>
              </li>
            </ul>

            {
              /* Sample figures stay off the page entirely. A page arguing for
                 reproducible research cannot show a fabricated series next to
                 real counts. The chart returns on its own the first time
                 fetch-stats.mjs writes live data (`sample` drops out). */
              !statsAreSample && (
                <div class="relab__chart">
                  <h4 class="draft">Fig. 2 — Disassembly over time</h4>
                  <p class="viz__caption">
                    Activity in RELab by month. Switch measures and hover a
                    column for the exact figure.
                  </p>
                  <DisassemblyChart stats={statsData} isSample={statsAreSample} client:visible />
                </div>
              )
            }
          </div>
        </article>

        {
          workProjects.map((p, i) => (
            <ProjectCard
              pos={i + 2}
              title={p.data.title}
              description={p.data.description}
              repo={p.data.repo}
              kind={p.data.kind}
              demo={p.data.demo}
              tags={p.data.tags}
              links={p.data.links}
            />
          ))
        }
      </div>

      <p class="prose upstream-note">
        Currently prototyping an <a href="https://github.com/simonvanlierde/ai4ie-demo">AI4IE resource hub</a> and a <a href="https://github.com/CMLPlatform/cml-gallery">project gallery</a> for CML. I also send fixes upstream to tools I build on, mostly in the FastAPI and open-LCA ecosystems, such as <a href="https://github.com/sabuhish/fastapi-mail/pull/283">fastapi-mail</a> and <a href="https://github.com/sentier-dev/sentier_data_tools/pull/2">sentier_data_tools</a>.
      </p>

      <details class="disclosure personal">
        <summary>
          <h3>Personal projects ({personalProjects.length})</h3>
        </summary>
        <div class="bom">
          {
            personalProjects.map((p, i) => (
              <ProjectCard
                pos={workProjects.length + 2 + i}
                title={p.data.title}
                description={p.data.description}
                repo={p.data.repo}
                kind={p.data.kind}
                demo={p.data.demo}
                tags={p.data.tags}
                links={p.data.links}
              />
            ))
          }
        </div>
      </details>
    </section>

    <section class="container" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <div class="cv-entries">
        {
          experience.map((job) => (
            <article class="cv-entry">
              <p class="cv-entry__period">{formatPeriod(job.start, job.end)}</p>
              <div class="cv-entry__body">
                <h3 class="cv-entry__role">{job.role}</h3>
                <p class="cv-entry__org">{job.organization}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="container" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <div class="cv-entries">
        {
          education.map((school) => (
            <article class="cv-entry">
              <p class="cv-entry__period">{formatPeriod(school.start, school.end)}</p>
              <div class="cv-entry__body">
                <h3 class="cv-entry__role">{school.degree}</h3>
                <p class="cv-entry__org">{school.institution}</p>
              </div>
            </article>
          ))
        }
      </div>

      <p class="prose cv-note">
        <a href="/cv/">Sheet 2, the full CV</a>, adds project highlights,
        skills, and a PDF download.
      </p>
    </section>

    <section class="container closing" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Contact</h2>
      <div class="closing__body">
        <p class="prose">
          For collaboration, roles, or questions about RELab and the tooling
          behind it:
        </p>
        {
          /* The sheet's one stamp is in the hero; the closing repeats the
             address as a plain working link, not a second stamp. */
          basics.email ? (
            <p class="closing__row draft">
              <a href={`mailto:${basics.email}`}>{basics.email}</a>
            </p>
          ) : (
            <p class="closing__row draft">
              <a href="/cv/">Sheet 2: curriculum vitae</a>
            </p>
          )
        }
      </div>
    </section>
  </main>

  <TitleBlock
    title={name}
    docType="Index of work"
    sheet="1 OF 2"
    dated={exported?.slice(0, 10)}
  />
</Base>

<style>
  .hero {
    padding-block: var(--space-l) var(--space-xl);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    /* The figure sits high beside the text, like a plate beside its notes. */
    .hero__figure {
      justify-self: end;
      width: 100%;
      max-width: 30rem;
    }
  }

  .hero h1 {
    /* Shared with the CV page's h1, so the name morphs between the two sheets
       rather than cross-fading with the rest of the document. */
    view-transition-name: person-name;
  }

  /* The question is the page's thesis: full ink, one step below the name. */
  .hero__question {
    max-width: 30rem;
    margin-top: var(--space-m);
    font-family: var(--font-draft);
    font-size: var(--step-2);
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-wrap: balance;
    color: var(--text);
  }

  .hero__tagline {
    margin-top: var(--space-m);
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .hero__actions {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }

  .hero__email {
    color: var(--text-muted);
    letter-spacing: 0.03em;
    user-select: all; /* one tap selects the whole address for copying */
  }

  .hero__profiles {
    margin-top: var(--space-m);
    font-size: var(--step--1);
  }

  /* Lead row: the platform's title outranks the repo slugs below it. */
  .relab-row__title {
    font-size: var(--step-2);
  }

  .relab-row__intro {
    color: var(--text-muted);
  }

  .relab__chart {
    container: chart / inline-size;
    position: relative;
    z-index: 1;
    width: fit-content;
    max-width: 100%;
  }

  .relab__chart h4 {
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .viz__caption {
    margin-top: var(--space-xs);
    margin-bottom: var(--space-l);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .upstream-note {
    margin-top: var(--space-l);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .cv-note {
    margin-top: var(--space-l);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  /* Disclosure: a collapsed <details> keeping secondary content below the
     work above. Native, no JS. */
  .disclosure {
    margin-top: var(--space-xl);
  }

  .disclosure summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
    /* Clears the 24px minimum and approaches 44 with line-height. */
    padding-block: var(--space-xs);
  }

  .disclosure summary::-webkit-details-marker {
    display: none;
  }

  .disclosure summary::before {
    content: "";
    width: 0.45em;
    height: 0.45em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .disclosure[open] summary::before {
    transform: rotate(45deg);
  }

  .disclosure summary h3 {
    color: inherit;
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .disclosure {
        interpolate-size: allow-keywords;
      }

      .disclosure::details-content {
        block-size: 0;
        overflow: hidden;
        opacity: 0;
        transition:
          block-size var(--dur-slow) var(--ease-out),
          content-visibility var(--dur-slow) allow-discrete,
          opacity var(--dur-base) ease;
      }

      .disclosure[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure summary::before {
      transition: none;
    }
  }

  .closing__body {
    margin-top: var(--space-l);
  }

  .closing__row {
    margin-top: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
  }
</style>
