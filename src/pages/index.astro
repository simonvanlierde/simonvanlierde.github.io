---
import { getCollection } from "astro:content";
import { formatCount as fmt } from "../components/chartScale.ts";
import DisassemblyChart from "../components/DisassemblyChart.tsx";
import ExplodedView from "../components/ExplodedView.astro";
import Figure from "../components/Figure.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SheetHead from "../components/SheetHead.astro";
import SheetNav from "../components/SheetNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { cv, profiles } from "../data/cv.ts";
import { participants, statsSource } from "../data/figures.ts";
import { figureParts } from "../data/projectSchema.ts";
import { homeJsonLd } from "../data/schemaOrg.ts";
import stats from "../data/stats.json" with { type: "json" };
import { upstream } from "../data/upstream.ts";
import Base from "../layouts/Base.astro";

// The history lives on /cv/; this sheet reads only the basics and the date.
const { basics, exported } = cv;

// Same payload as the chart, refreshed by scripts/fetch-stats.mjs.
const counts = { as_of: stats.as_of, ...stats.totals };
// The first month with a teardown: when the platform went into use.
const firstTeardown = stats.series.find((row) => row.teardowns > 0)?.label;
const asOfLabel = new Date(counts.as_of).toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const counted = (n: number) => ({ value: fmt(n), source: statsSource, as_of: counts.as_of });
const products = counted(counts.teardowns);
const components = counted(counts.parts);
const notes = [
  { ref: "A", label: "Products documented", figure: products },
  { ref: "B", label: "Components catalogued", figure: components },
  { ref: "C", label: "Images captured", figure: counted(counts.images) },
  { ref: "D", label: "Workshop participants", figure: participants },
];

const allProjects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const workProjects = allProjects.filter((p) => p.data.category === "work");
const personalProjects = allProjects.filter((p) => p.data.category === "personal");
const minorProjects = allProjects.filter((p) => p.data.category === "minor");

const name = basics.name;
const upstreamCount = upstream.reduce((sum, u) => sum + u.prs.length, 0);

const tagline =
  "At CML, Leiden University, I write open software and collect open data for industrial ecology and the circular economy. Most of my time goes into R9lab, where we take products apart to record what they're made of.";
---

<Base
  title={`${name} | Research software engineer for industrial ecology`}
  description={tagline}
  jsonLd={homeJsonLd(allProjects)}
>
  <SheetNav current="index" />

  {/* Skip target. A div, not <main>: a header inside <main> loses its banner role. */}
  <div id="main">
  <header class="container hero">
    <SheetHead />
    <div class="hero__grid">
      <div class="hero__intro">
        <p class="tagline prose">{tagline}</p>
        {/* Dated evidence on the first screen; the notes below have the full counts. */}
        <p class="hero__proof draft">
          <a href="#relab">
            R9lab to date: <Figure {...products} /> products taken apart,{" "}
            <Figure {...components} /> components catalogued
            (<time datetime={counts.as_of}>{asOfLabel}</time>).
          </a>
        </p>

        {/* Same order as the CV's header: contact, profiles, then the one stamp. */}
        {
          basics.email && (
            <ul class="link-list sheet-contact">
              <li>
                <a href={`mailto:${basics.email}`}>{basics.email}</a>
              </li>
            </ul>
          )
        }

        {/* Repeats the title block's profiles, which sit at the end of a long
            sheet. Muted, so the stamp stays the one primary action. */}
        <ul class="link-list sheet-profiles draft" aria-label="Profiles">
          {
            profiles.map((p) => (
              <li>
                <a href={p.href}>{p.label}</a>
              </li>
            ))
          }
        </ul>

        <a class="stamp sheet-stamp" href="/cv/">
          Curriculum vitae<span class="visually-hidden">, sheet 2</span>
        </a>
      </div>

      <div class="hero__figure">
        <ExplodedView />
      </div>
    </div>
  </header>

  <main>
    <section class="container" aria-labelledby="work-heading">
      <h2 id="work-heading">Selected work</h2>
      <div class="bom">
        <article class="bom-row r9lab-row" id="relab">
          <p class="bom-row__pos">Research platform</p>
          <div class="bom-row__body">
            <h3 class="bom-row__title r9lab-row__title">
              <a href="https://github.com/CMLPlatform/r9lab">R9lab</a>
            </h3>
            <div class="r9lab-row__intro prose">
              <p>
                Industrial ecology has little data on what products are made
                of. R9lab records it by taking durable goods apart, component
                by component. I designed and built the platform, and CML now
                uses it. It has a FastAPI backend, a
                PostgreSQL data model for life-cycle assessment, and an Expo /
                React Native capture app.
              </p>
              <p>In use at CML since {firstTeardown}, including two teardown workshops.</p>
            </div>
            <ul class="bom-row__links link-list">
              <li><a href="https://app.r9lab.io">Live platform</a></li>
              <li><a href="https://docs.r9lab.io">Documentation</a></li>
              <li>
                <a href="https://github.com/CMLPlatform/r9cam">
                  Raspberry Pi camera plugin
                </a>
              </li>
              <li><a href="https://doi.org/10.5281/zenodo.16637742">Zenodo record</a></li>
              <li>
                <a href="https://scorecard.dev/viewer/?uri=github.com/CMLPlatform/r9lab">
                  OpenSSF Scorecard
                </a>
              </li>
              <li>
                <a href="https://www.bestpractices.dev/projects/14492">OpenSSF Best Practices</a>
              </li>
            </ul>

            <section class="notes" aria-labelledby="notes-heading">
              <h4 id="notes-heading" class="notes__heading">
                Notes A–D<span class="notes__heading-aside"> · running totals</span>
              </h4>
              <ol class="notes__list">
                {
                  notes.map((n) => (
                    <li>
                      <span class="datum" aria-hidden="true">
                        {n.ref}
                      </span>
                      <span class="notes__value draft">
                        <Figure {...n.figure} />
                      </span>
                      <span class="notes__label">{n.label}</span>
                    </li>
                  ))
                }
              </ol>
              <p class="notes__foot draft">
                Products, components and images as counted <time datetime={counts.as_of}>{asOfLabel}</time>; participants at the two pilot workshops.
              </p>
            </section>

            <div class="r9lab__chart">
              <DisassemblyChart caption="Fig. 2: R9lab running totals" client:visible />
            </div>
          </div>
        </article>

        {
          workProjects.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              repo={p.data.repo}
              kind={p.data.kind}
              demo={p.data.demo}
              tags={p.data.tags}
              links={p.data.links}
              figures={p.data.figures}
            />
          ))
        }
      </div>

      <h3 class="minor-heading">Smaller projects</h3>
      <ul class="upstream-list minor-list">
        {
          minorProjects.map((p) => (
            <li>
              <a href={p.data.repo}>{p.data.title}</a>: {figureParts(p.data.description, p.data.figures).map((part) =>
                typeof part === "string" ? part : <Figure {...part} />,
              )}
              {p.data.demo && (
                <>
                  {" ("}
                  <a href={p.data.demo} aria-label={`Live demo of ${p.data.title}`}>
                    live
                  </a>
                  {")"}
                </>
              )}
            </li>
          ))
        }
      </ul>

      <p class="upstream-note">
        When an industrial-ecology library I use gets something wrong or runs slowly, I fix it upstream:
      </p>

      <details class="disclosure upstream" open>
        <summary>
          <h3>Merged upstream<span class="disclosure__count"> ({upstreamCount} pull requests)</span></h3>
        </summary>
        <ul class="upstream-list">
          {
            upstream.map((u) => (
              <li>
                <a href={`https://github.com/${u.repo}`}>{u.name}</a>: {u.what}
                {" ("}
                {u.prs.map((n, i) => (
                  <>
                    {i > 0 && ", "}
                    <a href={`https://github.com/${u.repo}/pull/${n}`}>#{n}</a>
                  </>
                ))}
                {")"}
              </li>
            ))
          }
        </ul>
      </details>

      <details class="disclosure personal" open>
        <summary>
          <h3>Personal projects<span class="disclosure__count"> ({personalProjects.length})</span></h3>
        </summary>
        <div class="bom">
          {
            personalProjects.map((p) => (
              <ProjectCard
                title={p.data.title}
                description={p.data.description}
                repo={p.data.repo}
                kind={p.data.kind}
                demo={p.data.demo}
                tags={p.data.tags}
                links={p.data.links}
                figures={p.data.figures}
              />
            ))
          }
        </div>
      </details>
    </section>

  </main>
  </div>

  {/* Date by the newer input, so the title block is never older than a figure on the page. */}
  <TitleBlock
    title={name}
    docType="Index of work"
    sheet="1 OF 2"
    turn={{ href: "/cv/", label: "sheet 2, CV", dir: "next" }}
    dated={[exported?.slice(0, 10), stats.as_of].filter(Boolean).sort().at(-1)}
  />
</Base>

<style>
  .hero {
    padding-block: var(--space-l) var(--space-m);
  }

  /* The title block's own top margin already spaces the last section from
     the footer. */
  main > section:last-child {
    padding-bottom: 0;
  }

  /* Starts where the CV's tagline starts, so only the content under the
     title zone changes between sheets. */
  .hero__grid {
    margin-top: var(--space-m);
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }

  .hero__intro > .tagline {
    margin-top: 0;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      align-items: start;
    }

    .hero__figure {
      justify-self: end;
      width: 100%;
    }
  }

  .hero__proof {
    margin-top: var(--space-m);
    max-width: var(--measure);
    font-size: var(--step--1);
    letter-spacing: 0.03em;
  }

  .hero__proof a {
    color: var(--text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .hero__proof a:hover {
    color: var(--accent-strong);
  }




  .notes {
    margin-top: var(--space-l);
    max-width: var(--measure);
    padding: var(--space-s) var(--space-m) var(--space-m);
    border: var(--border-width) solid var(--border-strong);
  }

  .notes__heading {
    font-family: var(--font-draft);
    font-weight: 400;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    padding-bottom: var(--space-2xs);
    border-bottom: var(--border-width) solid var(--border-strong);
  }

  .notes__heading-aside {
    color: var(--text-muted);
  }

  .notes__list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-s);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s) var(--space-m);
  }

  .notes__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-s);
    align-content: start;
  }

  /* One step below the h1, so the counts do not compete with the name. */
  .notes__value {
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--text);
  }

  .notes__label {
    grid-column: 2;
    font-family: var(--font-draft);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .notes__foot {
    margin-top: var(--space-s);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  /* R9lab's title outranks the repo names below it. */
  .r9lab-row__title {
    font-size: var(--step-2);
  }

  .r9lab-row__intro {
    color: var(--text-muted);
  }

  /* An inline-size container cannot size from its content, so it needs an
     explicit width: the plot's 30rem cap (see DisassemblyChart.css). */
  .r9lab__chart {
    container: chart / inline-size;
    width: 100%;
    max-width: 30rem;
    margin-top: var(--space-l);
  }

  .minor-heading {
    margin-top: var(--space-xl);
    color: var(--text-muted);
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .upstream-note {
    margin-top: var(--space-l);
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .disclosure {
    margin-top: var(--space-xl);
  }

  /* The note ends on a colon, so the list it introduces sits close. */
  .upstream-note + .disclosure {
    margin-top: var(--space-s);
  }

  /* Full sheet width: short lines of small type, so the measure would only add height. */
  .upstream-list {
    font-size: var(--step--1);
    padding-inline-start: var(--space-m);
  }

  .upstream-list li + li {
    margin-top: var(--space-2xs);
  }

  /* Start-aligned, so the chevron stays on the first line when the heading wraps. */
  .disclosure summary {
    display: flex;
    align-items: flex-start;
    gap: var(--space-xs);
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
    min-height: 44px;
    padding-block: var(--space-s);
    transition: color var(--dur-fast) ease;
  }

  .disclosure summary:hover {
    color: var(--accent-strong);
  }

  .disclosure summary::-webkit-details-marker {
    display: none;
  }

  .disclosure summary::before {
    content: "";
    flex: none;
    width: 0.45em;
    height: 0.45em;
    margin-top: 0.3em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .disclosure[open] summary::before {
    transform: rotate(45deg);
  }

  .disclosure summary h3 {
    color: inherit;
    font-size: var(--step-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The count says what a closed list holds; once open, the list says it. */
  .disclosure[open] .disclosure__count {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .disclosure {
        interpolate-size: allow-keywords;
      }

      .disclosure::details-content {
        block-size: 0;
        overflow: hidden;
        opacity: 0;
        transition:
          block-size var(--dur-slow) var(--ease-out),
          content-visibility var(--dur-slow) allow-discrete,
          opacity var(--dur-base) ease;
      }

      .disclosure[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure summary::before {
      transition: none;
    }
  }
</style>
