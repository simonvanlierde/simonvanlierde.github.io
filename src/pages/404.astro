---
// GitHub Pages serves this for any unmatched path. It keeps the site chrome
// so a wrong URL does not look like a broken host.
import SheetNav from "../components/SheetNav.astro";
import TitleBlock from "../components/TitleBlock.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | Simon van Lierde"
  description="That page does not exist on this site."
>
  <SheetNav />

  <main id="main" class="container notfound">
    <h1>That page does not exist</h1>
    <p class="prose">
      The link may be out of date, or the address may have a typo in it. This
      drawing set has two sheets:
    </p>
    <p class="notfound__row">
      <a class="stamp" href="/">Sheet 1: index of work</a>
      <a href="/cv/">Sheet 2: CV</a>
    </p>
  </main>

  <TitleBlock title="Simon van Lierde" docType="Page not found" sheet="NOT IN SET" />
</Base>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 60svh;
    padding-block: var(--space-xl);
  }

  .notfound p {
    margin-top: var(--space-m);
    color: var(--text-muted);
  }

  .notfound__row {
    margin-top: var(--space-l);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m) var(--space-l);
  }

  /* 44px target without moving the text. */
  .notfound__row a:not(.stamp) {
    padding-block: 0.65rem;
    margin-block: -0.65rem;
  }
</style>
