---
import { getCollection } from "astro:content";
import NoteList from "../../components/NoteList.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";

const notes = (await getCollection("notes")).sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Base title="Technical notes | Simon van Lierde" description="Short technical notes on research software, monitoring and infrastructure by Simon van Lierde.">
  <SiteHeader current="notes" />
  <main id="main" tabindex="-1" class="container archive">
    <header>
      <h1>Technical notes</h1>
      <p class="prose">Short write-ups of how research software is built and run.</p>
      <a class="stamp sheet-stamp" href="/notes/rss.xml">RSS feed</a>
    </header>
    <section aria-labelledby="notes-heading">
      <h2 id="notes-heading">Notes</h2>
      <NoteList notes={notes} />
    </section>
  </main>
  <SiteFooter />
</Base>
