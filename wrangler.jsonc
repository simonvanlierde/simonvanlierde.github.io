{
  // PR previews only: CI's preview job uploads each PR's build as a version of
  // this Worker. The live site stays on GitHub Pages (deploy.yml). The only
  // deploy is the placeholder page the preview job creates the Worker with.
  //
  // To rename, rename the Worker in the Cloudflare dashboard first: a preview
  // under a new name creates a new Worker, which then blocks the rename.
  "name": "simonvanlierde-site-preview",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Preview URLs need both.
  "preview_urls": true,
  "workers_dev": true
}
